{
  "name": "tillandsias-observatorium",
  "private": true,
  "type": "module",
  "scripts": {
    "metrics": "node scripts/build.mjs --metrics-only",
    "build": "node scripts/build.mjs",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev --local --ip 0.0.0.0 --port 8080",
    "serve": "node scripts/serve.mjs",
    "test": "node --test metrics/*.test.mjs scripts/*.test.mjs site/*.test.mjs",
    "release-snapshot": "node scripts/build.mjs --release-snapshot",
    "site": "node site/build.mjs",
    "site:deploy": "node site/build.mjs --deploy"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "4.150.0"
  }
}
