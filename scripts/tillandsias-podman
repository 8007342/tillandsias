#!/usr/bin/env bash
# Thin compatibility facade; orchestration belongs to the Rust CLI.
#
# Two low-end lessons baked in (esmeraldinha, N100 forge guest, 2026-09-01):
#   * If podman is absent from PATH, no invocation of the CLI can succeed —
#     answer the guaranteed negative immediately instead of building a wrapper
#     to discover it. Measured: the old fall-through cost 105s of cargo/rustc
#     ONCE PER FRESH VOLUME (then 18ms) to learn "No such file or directory".
#   * Probe release/ as well as debug/: the forge builds its artifacts
#     --release, so a guest with a warm release cache was still paying the
#     debug compile because only debug/ was ever consulted.
set -euo pipefail
if ! command -v podman >/dev/null 2>&1; then
    echo "tillandsias-podman: podman is not on PATH — the volume/container query cannot succeed on this host" >&2
    exit 1
fi
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# ORDER 1270-5mz8: a prebuilt is chosen because it is FRESH, not because it
# EXISTS. The first candidate newer than every source under the two crates it
# is built from wins. If only stale ones exist, refuse by name with the rebuild
# command and never run one: on 2026-09-19 this loop picked a four-day-old
# debug build by `-x` alone and two release gates ran the forge lane on code
# the tree no longer held.
PODMAN_CLI_BIN=""
STALE_BINS=()
for profile in release debug; do
    for base in "${CARGO_TARGET_DIR:+$CARGO_TARGET_DIR}" "${CARGO_TARGET_DIR:+$ROOT/$CARGO_TARGET_DIR}" "$ROOT/target"; do
        [[ -n "$base" ]] || continue
        [[ "$base" = /* ]] || continue
        cand="$base/$profile/tillandsias-podman-cli"
        [[ -x "$cand" ]] || continue
        newer="$(find "$ROOT/crates/tillandsias-podman-cli" "$ROOT/crates/tillandsias-podman" \
            -type f -newer "$cand" -print -quit 2>/dev/null || true)"
        if [[ -z "$newer" ]]; then
            PODMAN_CLI_BIN="$cand"
            break 2
        fi
        STALE_BINS+=("$cand (older than ${newer#"$ROOT"/})")
    done
done
if [[ -n "$PODMAN_CLI_BIN" ]]; then
    exec "$PODMAN_CLI_BIN" "$@"
fi
if [[ ${#STALE_BINS[@]} -gt 0 ]]; then
    for stale in "${STALE_BINS[@]}"; do
        echo "refused:podman-cli-stale:${stale%% (*}:rebuild=cargo build -p tillandsias-podman-cli" >&2
        why="${stale#* (}"
        echo "  why: this prebuilt is ${why%)}; running it would test code the tree no longer holds (1270-5mz8)" >&2
    done
    echo "  remedy: rebuild it (add --release for the release profile), or remove the stale binary so the shim falls back to cargo run" >&2
    exit 1
fi
exec cargo run --quiet -p tillandsias-podman-cli -- "$@"
