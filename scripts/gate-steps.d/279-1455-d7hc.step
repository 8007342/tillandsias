# Gate step 1455-d7hc — data, not code (order 1072-b7eq).
#
# The metrics writer (Rust) and reader (shell) must resolve the SAME log, in a
# clone and in a linked worktree (whose `.git` is a file). This fixture existed
# since 890-t9pu but no gate ran it, so it went red on 2026-09-20 (1268-m2ir)
# and stayed red unseen.
#
# STEP_SCRIPT is a LITERAL path on purpose (1063-nraf).
STEP_DESC="Checking the metrics writer and reader resolve one log (1455-d7hc)"
STEP_LUA="scripts/lua/test-metrics-log-path-agreement.lua"
STEP_ERROR="the Rust metrics writer and the shell reader resolve different logs, or the outside-a-checkout fallback broke (1455-d7hc) — see the FAIL lines above"
STEP_OK="Metrics log path agreement passed"
STEP_SECOND_REGIME="doris 2026-11-26 msys ok:metrics-log-path-agreement:20 arms"
# ORDER 2155-gpar: runs alone, never beside a sibling step in the gate pool.
STEP_SERIAL="watches the shared timing or metrics log, or runs a nested gate"
# 2192-excl: EXCLUSIVE, not just the timing lane. It writes the fixed
# /tmp/tillandsias-timing.jsonl and counts lines of the fixed
# /tmp/forge-expert-usage.jsonl before and after a run (its own header), so ANY
# concurrent writer, a step in another lane or a live expert, breaks its count.
# Deterministic under JOBS=6 on macuahuitl (run 27: #1248 and #1287 evicted).
STEP_LANES="timing exclusive"
# ORDER 2157-ginp: STEP_READS, the paths this step reads, RECORDED ONLY: never
# consulted by the class-selector skip (that is STEP_INPUTS, 2118-tnut). First
# cut: the step's own script plus every repo path it names literally.
STEP_READS="plan/index.yaml scripts/check-mcp-expert-health.sh scripts/check-mcp-surface.sh scripts/cycle-metrics.sh scripts/metrics-log-path.sh scripts/plan-binary-probe.sh scripts/lua/test-metrics-log-path-agreement.lua"
