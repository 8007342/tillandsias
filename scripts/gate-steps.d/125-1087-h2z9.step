# Gate step — data, not code (order 1072-b7eq). Wired by 1087-h2z9.
#
# Triaged from scripts/gate-divergence-declared.txt, where it sat `untriaged`
# since 2026-09-06: present in --ci-full, absent from --check, nobody decided.
# Measured green and cheap on b026372ff (Container base policy), so the honest verdict is to run
# it where every host lands rather than once a day on the release gate.
#
# STEP_SCRIPT is a LITERAL path on purpose (1063-nraf): a binding assembled
# from a variable is invisible to every name-based scan. 2067-dwqd ported the
# checker to Lua, so the binding is STEP_LUA; the regime pin below is the .sh's
# darwin run, and the Lua runner is the same plan binary on every regime.
STEP_DESC="Checking Containerfile bases against policy"
STEP_LUA="scripts/lua/check-container-bases.lua"
STEP_ERROR="a Containerfile uses a base outside policy (1087-h2z9)"
STEP_OK="Container base policy passed"
STEP_SECOND_REGIME="macneo 2026-09-22 darwin ok:rc0-no-verdict-line"
# ORDER 2155-gpar: runs alone, never beside a sibling step in the gate pool.
STEP_SERIAL="drives podman"
STEP_LANES="podman"
# ORDER 2157-ginp: STEP_READS, the paths this step reads, RECORDED ONLY: never
# consulted by the class-selector skip (that is STEP_INPUTS, 2118-tnut). First
# cut: the step's own script plus every repo path it names literally.
STEP_READS="crates/tillandsias-core/src/container_profile.rs crates/tillandsias-podman/src/client.rs docs/cheatsheets/** images/chromium/Containerfile.core images/chromium/Containerfile.framework images/default/Containerfile images/default/Containerfile.base images/git/Containerfile images/inference/Containerfile images/proxy/Containerfile images/router/Containerfile images/web/Containerfile openspec/specs/** scripts/lua/check-container-bases.lua"
