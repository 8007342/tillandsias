STEP_ERROR="./build.sh --changed's fixture pool lost its order, isolation, serial rule or concurrency (1931-steb)"
STEP_OK="--changed input-selection fixture passed"
STEP_SERIAL="asserts wall-clock bounds (four 1 s stub fixtures under 2.5 s at 4 jobs); pool load would make it flaky"
STEP_LANES="timing"
