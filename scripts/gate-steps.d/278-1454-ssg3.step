# Gate step 1454-ssg3 — data, not code (order 1072-b7eq).
#
# BSD count shapes (grep -lc prints file:N AND file; wc -l left-pads) are
# reproduced by stubs on EVERY host, so a gate count cannot regress on darwin
# while Linux runs stay green.
#
# STEP_LUA is a LITERAL path on purpose (1063-nraf).
STEP_DESC="Checking gate counts survive the BSD grep/wc shapes on any host (1454-ssg3)"
STEP_LUA="scripts/lua/test-bsd-count-shapes.lua"
STEP_ERROR="a gate count no longer survives BSD grep -lc or padded wc -l, so a darwin gate would read it wrong (1454-ssg3) — see the verdict line above"
STEP_OK="BSD count shapes passed"
STEP_SECOND_REGIME="tlatoanis-macbook-air 2026-09-28 darwin ok:bsd-count-shapes:4/4"
# ORDER 2155-gpar: runs alone, never beside a sibling step in the gate pool.
STEP_SERIAL="builds with cargo into the shared target"
STEP_LANES="cargo"
# ORDER 2157-ginp: STEP_READS, the paths this step reads, RECORDED ONLY: never
# consulted by the class-selector skip (that is STEP_INPUTS, 2118-tnut). First
# cut: the step's own script plus every repo path it names literally.
STEP_READS="openspec/litmus-tests/litmus-fragment-ts-skew.yaml scripts/hooks/pre-push-local-gate.sh build.sh scripts/lua/test-bsd-count-shapes.lua"
