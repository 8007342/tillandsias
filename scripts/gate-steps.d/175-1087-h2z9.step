# Gate step — data, not code (order 1072-b7eq). Wired by 1087-h2z9.
#
# Triaged from scripts/gate-divergence-declared.txt, where it sat `untriaged`
# since 2026-09-06: present in --ci-full, absent from --check, nobody decided.
# Measured green and cheap on b026372ff (Fast-refusal ordering), so the honest verdict is to run
# it where every host lands rather than once a day on the release gate.
#
# STEP_SCRIPT is a LITERAL path on purpose (1063-nraf): a binding assembled
# from a variable is invisible to every name-based scan.
STEP_DESC="Checking the fast-refusal phase precedes the first compile"
STEP_SCRIPT="scripts/test-gate-fast-refusals.sh"
STEP_ERROR="a fast refusal was hoisted behind a build step (1087-h2z9)"
STEP_OK="Fast-refusal ordering passed"
STEP_SECOND_REGIME="macneo 2026-09-22 darwin ok:test-gate-fast-refusals:4"
# ORDER 2155-gpar: runs alone, never beside a sibling step in the gate pool.
STEP_SERIAL="watches the shared timing or metrics log, or runs a nested gate"
STEP_LANES="timing"
# ORDER 2157-ginp: the paths this step reads, RECORDED ONLY (not yet used to
# skip it; that waits on an operator ruling). First cut: the step's own script
# plus every repo path it names literally.
STEP_INPUTS="plan/issues/** scripts/check-litmus-pin-claims.sh scripts/local-ci.sh scripts/test-gate-fast-refusals.sh"
