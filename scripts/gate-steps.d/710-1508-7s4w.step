# Gate step 1508-7s4w — data, not code (order 1072-b7eq).
#
# WHAT IT GUARDS. On MSYS an extensionless probe candidate whose .exe sibling
# exists IS that .exe (exe magic), so resolve_plan_binary answered the DEBUG
# build ahead of a fresh release .exe whenever the release extensionless name
# held an unrunnable file (yolanda 2026-09-29). The probe now skips such
# candidates on MSYS/Cygwin only, and lets the .exe entries answer in their
# release-before-debug order. The fixture runs its MSYS arm on Git Bash and
# its Linux negative control (order unchanged) on Linux, each skipping the
# other by name. Pre-fix MSYS: 0/1, answering ./target/debug/tillandsias-plan.
#
# STEP_LUA is a LITERAL path on purpose (1063-nraf).
STEP_DESC="Checking the plan-binary probe prefers a release .exe over a debug build on MSYS (1508-7s4w)"
STEP_LUA="scripts/lua/test-plan-binary-probe-release-over-debug.lua"
STEP_ERROR="the plan-binary probe again answers a debug build ahead of the release .exe on MSYS, or its Linux order changed (1508-7s4w); see which arm failed above"
STEP_OK="plan-binary probe answers the release .exe on MSYS and keeps its Linux order"
STEP_SECOND_REGIME="yolanda 2026-11-24 msys ok:plan-binary-probe-release-over-debug:4 arms"
STEP_SECOND_REGIME="tlatoanis-macbook-air 2026-11-24 darwin ok:plan-binary-probe-release-over-debug:1 arms"
# ORDER 2155-gpar: runs alone, never beside a sibling step in the gate pool.
STEP_SERIAL="builds with cargo into the shared target"
STEP_LANES="cargo"
# ORDER 2157-ginp: STEP_READS, the paths this step reads, RECORDED ONLY: never
# consulted by the class-selector skip (that is STEP_INPUTS, 2118-tnut). First
# cut: the step's own script plus every repo path it names literally.
STEP_READS="scripts/plan-binary-probe.sh scripts/lua/test-plan-binary-probe-release-over-debug.lua"
