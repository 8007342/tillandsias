# ORDER 1903-djsq + 2118-9kqp (priority:build-speed). The eight credential
# fixtures run ONCE, here, under the stricter regime: a sentinel session bus.
# They used to be six gate steps and two inline build.sh calls AND be re-run by
# this check, so ~36 s per gate was paid twice. This step judges each fixture's
# own verdict (its declared could-not-run code is a named skip) and that it made
# no connection to the bus it inherited. On a host with no dbus-daemon (macOS)
# the fixtures still run and are judged; only the bus arm is a named skip.
STEP_DESC="Checking the credential fixtures pass and none reaches the session bus it inherited (1903-djsq, 2118-9kqp)"
STEP_SCRIPT="scripts/test-keyring-fixtures-use-a-private-bus.sh"
STEP_ERROR="a credential fixture failed, or reached the session bus it inherited (1903-djsq) — read the 'verdict:' or 'bus:' line naming it above; on an operator host the inherited bus is gnome-keyring-daemon, which aborts and restarts LOCKED (1265-8qr6): source scripts/test-support/private-session-bus.sh in that fixture and stub what it fell through to"
STEP_OK="credential fixtures pass and stay off the inherited session bus"
# Carried from 240-900-z3kv (the cold-state fixture): a keyring cold state can
# disagree with itself on a healthy tree, so the step gets ONE settled retry.
STEP_HOST_STATE="keyring"
STEP_SERIAL="reads host keyring state; owns a sentinel dbus-daemon"
# ORDER 2171-addv (priority:build-speed). ONE lane, host. "podman host" made
# this step EXCLUSIVE (it ran alone after the lanes, ~23 s). Measured: with a
# logging podman shim first on PATH the full 26-arm run made 0 real podman calls
# (the only podman is a PATH stub inside the partial-is-nonzero fixture), and no
# fixture names an absolute podman path. A fixture that starts driving the real
# store must add the podman lane back, which makes the step exclusive again.
STEP_LANES="host"
# Measured on darwin for the merged step (2118-9kqp): 8/8 credential verdicts
# ok; the bus arm is a named skip there (no dbus-daemon on macOS).
STEP_SECOND_REGIME="tlatoanis-macbook-air 2026-11-21 darwin skip:keyring-fixtures-use-a-private-bus:bus-arm:no-dbus-daemon(8/8-verdicts-ok)"
# ORDER 2157-ginp: STEP_READS, the paths this step reads, RECORDED ONLY (never
# consulted by the class-selector skip; that is STEP_INPUTS, 2118-tnut).
STEP_READS="scripts/test-keyring-fixtures-use-a-private-bus.sh crates/tillandsias-headless/src/remote_projects.rs scripts/test-support/private-session-bus.sh crates/tillandsias-headless/src/vault_bootstrap.rs scripts/check-credential-channel.sh scripts/lua/check-refusal-affordance-added.lua scripts/clear-vault-host-credentials.sh scripts/probe-credential-cold-state.sh scripts/test-check-credential-channel.sh scripts/test-credential-verdict-script.sh scripts/test-clear-vault-credentials-partial-is-nonzero.sh scripts/test-clear-vault-host-credentials.sh scripts/test-credential-channel-affordances.sh scripts/test-credential-channel-names-a-locked-keyring.sh scripts/test-credential-channel-survives-a-killed-probe.sh scripts/test-credential-cold-state-probe.sh"
