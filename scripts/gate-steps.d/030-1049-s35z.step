# Gate step 1049-s35z — data, not code (order 1072-b7eq).
#
# STEP_SCRIPT is a LITERAL path on purpose: a binding assembled from a
# variable is invisible to every name-based scan, including the
# bound-or-retired guard (1063-nraf). Keep it a plain string.
STEP_DESC="Checking a missing bound litmus test reds rather than skips (1049-s35z)"
STEP_SCRIPT="scripts/test-litmus-missing-bound-test-reds.sh"
STEP_ERROR="a bound litmus test with no file no longer reds, or the CR strip is gone (1049-s35z) — see the verdict line above"
STEP_OK="Missing-bound-test check passed"
STEP_SECOND_REGIME="macneo 2026-09-22 darwin ok:litmus-missing-bound-test:6"
# ORDER 2155-gpar: runs alone, never beside a sibling step in the gate pool.
STEP_SERIAL="runs the litmus runner (it wipes its runtime dirs)"
STEP_LANES="litmus"
# ORDER 2157-ginp: the paths this step reads, RECORDED ONLY (not yet used to
# skip it; that waits on an operator ruling). First cut: the step's own script
# plus every repo path it names literally.
STEP_INPUTS="openspec/litmus-bindings.yaml openspec/litmus-tests/** scripts/run-litmus-test.sh scripts/test-litmus-missing-bound-test-reds.sh"
