#!/usr/bin/env bash
# Thin compatibility facade for tillandsias-policy.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
POLICY_BIN="$ROOT/target/debug/tillandsias-policy"
if [[ -n "${CARGO_TARGET_DIR:-}" ]]; then
    if [[ "$CARGO_TARGET_DIR" = /* ]]; then
        [[ -x "$CARGO_TARGET_DIR/debug/tillandsias-policy" ]] && POLICY_BIN="$CARGO_TARGET_DIR/debug/tillandsias-policy"
        [[ -x "$CARGO_TARGET_DIR/release/tillandsias-policy" ]] && POLICY_BIN="$CARGO_TARGET_DIR/release/tillandsias-policy"
    else
        [[ -x "$ROOT/$CARGO_TARGET_DIR/debug/tillandsias-policy" ]] && POLICY_BIN="$ROOT/$CARGO_TARGET_DIR/debug/tillandsias-policy"
        [[ -x "$ROOT/$CARGO_TARGET_DIR/release/tillandsias-policy" ]] && POLICY_BIN="$ROOT/$CARGO_TARGET_DIR/release/tillandsias-policy"
    fi
fi
if [[ -x "$POLICY_BIN" ]]; then
    exec "$POLICY_BIN" "$@"
fi
exec cargo run --quiet -p tillandsias-policy -- "$@"
