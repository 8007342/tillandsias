# Rust build artifacts
/target/
# Sidecar nested-cargo target dir (avoids workspace lock deadlock).
# @trace spec:opencode-web-session-otp
/target-musl/
# Guest-binary cross builds (scripts/build-guest-binaries.sh, 5af983061).
/target-guest/
/target/forge-diagnostics

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Nix build output cache
.nix-output/

# Secrets
.env
*.pem
*.key
result
/result
/result-*
.claude/worktrees/

# Vendored debug sources
vendor/debug/

# Staged by scripts/build-image.sh — agent-cheatsheets
# @trace spec:cheatsheets-license-tiered
images/default/.cheatsheets/

# Staged by scripts/build-image.sh — cheatsheets-license-tiered
# (bundled-tier bake + meta side-channel)
# @trace spec:cheatsheets-license-tiered
images/default/.cheatsheet-sources/
images/default/.cheatsheets-meta/

# Image build staging for the forge agent wiring (35ba3d3f4). Same
# build-image.sh staging class as the dot-prefixed entries above; these are the
# un-prefixed destinations it populates.
images/default/skills/
images/default/cheatsheets/
images/default/cheatsheet-sources/

# Pre-built tillandsias-router-sidecar (musl static-pie binary).
# Built by scripts/build-sidecar.sh; embedded into tray binary via
# include_bytes! in src-tauri/src/embedded.rs. Not source-controlled —
# rebuilds on every fresh clone.
# @trace spec:opencode-web-session-otp
images/router/tillandsias-router-sidecar

# Content-addressed staleness stamp for the sidecar, replacing the mtime probe
# (765-5efu, e2a421b40). A build artifact of the same class as the binary above.
images/router/.sidecar.stamp

# cheatsheet-sources: TOMBSTONED by cheatsheets-license-tiered (replaced by
# image-baked /opt/cheatsheet-sources/ + per-project pull cache). The whole
# directory is now gitignored to guard against any local cache pollution that
# the legacy fetcher might emit during the retention window.
# Keep cheatsheet-sources/.gitkeep-tombstone tracked (negation) so the
# tombstone marker survives the gitignore.
# @trace spec:cheatsheets-license-tiered, spec:cheatsheet-source-layer
cheatsheet-sources/
!cheatsheet-sources/.gitkeep-tombstone

# Local diagnostic capture artifacts produced by manual --diagnostics smoke
# runs (stdout/stderr redirects). Ephemeral debugging state — never source-
# controlled. Patterns cover diag*.log/err, smoke*.log/err, err*.log,
# out*.log when written at the workspace root.
# @trace spec:runtime-diagnostics-stream
/diag*.log
/diag*.err
/smoke*.log
/smoke*.err
/err*.log
/out*.log

# Build proxy log (generated by build scripts)
/build-proxy.log
/build-*-progress.jsonl

# Git-mirror seed/build log (d4df11750) — same generated-log class as the
# build-proxy log above.
build-git.log

# Local runtime configuration (per-machine)
/.tillandsias/

# Session-local cron scheduler runtime state (not source)
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json

# Local materializer cache (rebuilt by recipe-publish CI; never committed)
/out-cache
/dist

# Release packaging staging (build-windows-tray.ps1 -Release / release CI jobs)
/release-artifacts

# Local e2e release-test artifacts (c38e91f83) — a staging dir of the same
# class as /release-artifacts above, written by local release smoke runs.
mock-release/

# macOS packaging spike + guest-binary embedding scratch (399d2cfca).
/research/images/
/research/vfr-spike/.build/

# Generated artifacts, dashboards, and temporary workspace files
/artifacts/
/dashboards/
*.tmp
*.temp
.forge-startup-context.md
# Generated per-image build logs (build-image.sh writes build-<IMAGE>.log)
build-*.log

# Generated diagnostic raw logs and dumps (summaries in plan/diagnostics/ are durable and committed; see plan/diagnostics/README.md; 745-48q6)
/plan/diagnostics/*.log
/plan/diagnostics/*.raw
/plan/diagnostics/*.dump
/plan/diagnostics/*.tmp
/forge-diagnostics.json

# Generated headless binaries for Windows tray embed
crates/tillandsias-windows-tray/assets/tillandsias-headless-*

# Launch-generated forge artifacts — regenerated by the agent harness at
# launch; tracking them dirties the checkout on every forge start (order 444).
.opencode/package-lock.json
.opencode/node_modules

# @trace order:707-t3mz — On-Demand-Subject-Experts. Pulled external docs are
# EPHEMERAL and NEVER committed (pull-on-demand, re-pulled per forge launch by
# design). Canonical location is OUTSIDE the repo (~/.cache/tillandsias/), but
# guard against any repo-relative pull polluting the project on a dev machine.
**/experts-pulled/
**/cheatsheets-pulled/
**/docs-pulled/
.cache/

# Leaked/launch log shapes not caught by the build-*/diag*/out*/smoke*/err* prefixes
# (audit 2026-08-12: init-debug*.log, tray_output.log were tracked before any pattern existed)
/init-*.log
/tray_output.log
# Defense-in-depth against the artifact-leak class that put target-musl/** in history:
# catch Rust/obj artifacts and node_modules even if they ever land OUTSIDE a target*/ dir.
# 723-ydmk: extended to the executable/linkable extensions actually seen in the
# leaked history (.so was among them; *.o/*.rlib alone missed every one of the
# three known leaks). Tracked-file enforcement is scripts/check-no-tracked-binaries.sh —
# an ignore rule is inert for anything already tracked.
node_modules/
*.rlib
*.o
*.so
*.dylib
*.dll
*.exe
*.a
*.wasm
*.pdb
.claude/settings.local.json
