#!/usr/bin/env bash
# flutter — run Flutter for this forge's project.
#
# The forge image carries no Flutter SDK (2.5 GB unpacked). The usual path is
# the host: over the lane's MCP socket, flutter-lane asks the host to run
# `flutter <args>` in the shared tillandsias-flutter image (1637-5765).
#
# When the host cannot (order 1874-pn3s), in order:
#   1 a cached SDK in the durable project cache,
#     $TILLANDSIAS_PROJECT_CACHE/flutter-sdk/bin/flutter (the cache volume,
#     never the ~/src tmpfs, which is lost with the forge), runs instead;
#   2 otherwise a typed refusal names why and the remedy:
#       refused:flutter:<reason> remedy=<what to do>
#     with exit 69 (EX_UNAVAILABLE), where the bare `exit 69` used to be.
#
# @trace spec:local-web-preview, order:1637-5765, order:1874-pn3s

LIB_DIR="${TILLANDSIAS_FLUTTER_LIB_DIR:-/usr/local/lib/tillandsias}"
LANE_CLIENT="${TILLANDSIAS_FLUTTER_LANE_CLIENT:-/opt/agents/tillandsias-cli/libexec/flutter-lane}"
CACHE="${TILLANDSIAS_PROJECT_CACHE:-/home/forge/.cache/tillandsias-project}"
SRC="${TILLANDSIAS_FLUTTER_SRC_DIR:-/home/forge/src}"
UNAVAILABLE=69

# shellcheck source=../lib-lane.sh
source "$LIB_DIR/lib-lane.sh" 2>/dev/null || lane_socket_state() { echo unknown; }

lane="$(lane_socket_state)"
why=""
if [ "$lane" = ready ]; then
    "$LANE_CLIENT" "$@"
    rc=$?
    # 69 is the client's own "the host cannot run it"; any other code is
    # flutter's, and is the answer.
    [ "$rc" -ne "$UNAVAILABLE" ] && exit "$rc"
    why="host-toolchain-unavailable"
else
    why="lane-$lane"
fi

sdk="$CACHE/flutter-sdk/bin/flutter"
case "$CACHE/" in
    "$SRC"/*) sdk="" ;; # a cache on the src tmpfs is no cache
esac
if [ -n "$sdk" ] && [ -x "$sdk" ]; then
    echo "flutter (tillandsias): host toolchain unavailable ($why); using the cached SDK at $sdk" >&2
    exec "$sdk" "$@"
fi

case "$why" in
    lane-stale)
        remedy="the lane socket exists but nothing on the host accepts; with the tray running it is re-served within a second, then retry (tillandsias-doctor shows host_lane)" ;;
    lane-absent|lane-unset)
        remedy="this forge was launched without a host lane; relaunch it from the tray, or place an SDK at $CACHE/flutter-sdk" ;;
    host-toolchain-unavailable)
        remedy="the host could not prepare the tillandsias-flutter image (see the message above); retry, or place an SDK at $CACHE/flutter-sdk" ;;
    *)
        remedy="lib-lane.sh is missing from $LIB_DIR, so the lane cannot be judged; run tillandsias-doctor" ;;
esac
echo "refused:flutter:$why remedy=$remedy" >&2
exit "$UNAVAILABLE"
