#!/usr/bin/env lua
-- tillandsias-models — list ollama models loaded in the enclave inference
-- container, annotated with their planner tier. Exits 1 with a single
-- diagnostic line when the inference container is unreachable.
--
-- Usage: tillandsias-models [--json]
--
-- @trace spec:forge-environment-discoverability, order:2380-ds8v
-- @cheatsheet runtime/forge-paths-ephemeral-vs-persistent.md, runtime/forge-container.md
--
-- Stock Lua 5.4; curl fetches and jq parses, as before.

local HELP = [[
tillandsias-models — list ollama models loaded in the enclave inference
container, annotated with their planner tier. Exits 1 with a single
diagnostic line when the inference container is unreachable.

Usage: tillandsias-models [--json]

]]

local mode = arg[1] or ""
if mode == "-h" or mode == "--help" then io.stdout:write(HELP); os.exit(0) end
if mode ~= "" and mode ~= "--json" then
    io.stderr:write("tillandsias-models: unknown arg '" .. mode .. "'\nusage: tillandsias-models [--json]\n")
    os.exit(2)
end
local json = mode == "--json"
local function getenv(n) local v = os.getenv(n); return v ~= "" and v or nil end
local function quote(s) return "'" .. s:gsub("'", "'\\''") .. "'" end
local function capture(cmd)
    local p = io.popen(cmd)
    local o = p:read("a") or ""
    p:close()
    return o
end
local function str(s)
    return '"' .. s:gsub('[%c"\\\127]', function(c)
        if c == '"' or c == "\\" then return "\\" .. c end
        return ("\\u%04x"):format(c:byte())
    end) .. '"'
end
local URL = getenv("TILLANDSIAS_INFERENCE_URL") or "http://inference:11434"
local function nothing(why) io.stdout:write(('{"error":"%s","url":%s,"models":[]}\n'):format(why, str(URL))) end

-- Order 482d: the tier a model prints is the CANONICAL table's tier, read from
-- byte-identical copies of images/inference/tiers/{tier-table,models.ollama}.tsv
-- (this image's build context cannot reach that directory, so the copies ship
-- here and litmus:inference-tier-table-migration asserts they are identical).
-- A model the table does not name prints --.
local DIR = getenv("TILLANDSIAS_CLI_TIERS_DIR")
if not DIR then
    local self = capture("readlink -f " .. quote(arg[0] or "")):gsub("\n$", "")
    DIR = (self:match("^(.*)/[^/]*$") or ".") .. "/../share/tiers"
end
-- Rows of a table, split on tabs, comments and blanks dropped.
local function rows(name)
    local f = io.open(DIR .. "/" .. name, "r")
    if not f then return nil end
    local t = {}
    for l in f:lines() do
        if l ~= "" and l:sub(1, 1) ~= "#" then
            local c = {}
            for v in (l .. "\t"):gmatch("([^\t]*)\t") do c[#c + 1] = v end
            t[#t + 1] = c
        end
    end
    f:close()
    return t
end
local adapter, table_rows = rows("models.ollama.tsv"), rows("tier-table.tsv")
local function tier_for(tag)
    if not (adapter and table_rows) then return "--" end
    for _, a in ipairs(adapter) do
        if a[2] == tag then
            for _, t in ipairs(table_rows) do
                if ("," .. (t[4] or "") .. ","):find("," .. a[1] .. ",", 1, true) then return t[1] end
            end
            return "--"
        end
    end
    return "--"
end

-- One shell, so the answer never travels on a command line (Linux caps one argument at
-- 128 KiB): `up`, then name<TAB>size<TAB>modified<TAB>digest, one model a line.
local answer = capture("raw=\"$(curl -fsS --max-time 3 " .. quote((URL:gsub("/$", "")) .. "/api/tags") .. " 2>/dev/null)\"; [ -n \"$raw\" ] || exit 0; echo up; "
    .. [[printf '%s' "$raw" | jq -r '.models[] | [.name, (.size|tostring), (.modified_at//""), (.digest//"")] | @tsv' 2>/dev/null]])
local tsv = answer:match("^up\n(.*)$")
if not tsv then
    if json then nothing("inference container not running")
    else io.stderr:write(("inference container not running (%s/api/tags unreachable)\n"):format(URL)) end
    os.exit(1)
end

local models = {}
for l in tsv:gmatch("[^\n]+") do
    local c = {}
    for v in (l .. "\t"):gmatch("([^\t]*)\t") do c[#c + 1] = v end
    if (c[1] or "") ~= "" then models[#models + 1] = { name = c[1], tier = tier_for(c[1]), size = tonumber(c[2]) or 0, modified = c[3] or "", digest = c[4] or "" } end
end
if #models == 0 then
    if json then nothing("no models loaded") else io.stdout:write(("no models loaded at %s\n"):format(URL)) end
    os.exit(0)
end

if json then
    local out = {}
    for i, m in ipairs(models) do
        out[i] = ('{"name":%s,"tier":%s,"size_bytes":%d,"modified_at":%s,"digest":%s}'):format(str(m.name), str(m.tier), m.size // 1 | 0, str(m.modified), str(m.digest))
    end
    io.stdout:write(('{"url":%s,"models":[%s]}\n'):format(str(URL), table.concat(out, ",")))
else
    io.stdout:write(("Tillandsias inference models (%s)\n\n"):format(URL) .. ("  %-4s %-28s %-14s %s\n"):format("TIER", "NAME", "SIZE", "MODIFIED"))
    for _, m in ipairs(models) do
        io.stdout:write(("  %-4s %-28s %-14s %s\n"):format(m.tier, m.name, (m.size // 1048576 | 0) .. " MiB", (m.modified:match("^(.-)%.") or m.modified)))
    end
end
