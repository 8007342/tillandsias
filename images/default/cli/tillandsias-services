#!/usr/bin/env lua
-- tillandsias-services — print the discoverable enclave services + status.
-- Hardcoded list: the agent needs a SOURCE OF TRUTH for what is reachable
-- from the forge. Status is checked with `nc -z` (1s timeout), or bash's
-- /dev/tcp fallback if nc is missing.
--
-- Usage: tillandsias-services [--json]
--
-- @trace spec:forge-environment-discoverability, order:2380-ds8v
-- @cheatsheet runtime/forge-paths-ephemeral-vs-persistent.md, runtime/forge-container.md
--
-- Stock Lua 5.4. The host is quoted for sh: the git host comes from the environment.

local HELP = [[
tillandsias-services — print the discoverable enclave services + status.
Hardcoded list: the agent needs a SOURCE OF TRUTH for what is reachable
from the forge. Status is checked with `nc -z` (1s timeout), or bash's
/dev/tcp fallback if nc is missing.

Usage: tillandsias-services [--json]

@trace spec:forge-environment-discoverability
]]

local mode = arg[1] or ""
if mode == "-h" or mode == "--help" then io.stdout:write(HELP); os.exit(0) end
if mode ~= "" and mode ~= "--json" then
    io.stderr:write("tillandsias-services: unknown arg '" .. mode .. "'\nusage: tillandsias-services [--json]\n")
    os.exit(2)
end

local function getenv(n) local v = os.getenv(n); return v ~= "" and v or nil end
-- Service catalogue — name|host|port|protocol|description|hint
-- Order 659-8faj: the git mirror answers only at its per-project DNS name
-- (`git-<project>`), injected by the launcher as TILLANDSIAS_GIT_SERVICE; the
-- shared `git-service` / `tillandsias-git` aliases are retired.
local GIT_HOST = getenv("TILLANDSIAS_GIT_SERVICE") or ("git-" .. (os.getenv("TILLANDSIAS_PROJECT") or ""))
local SERVICES = {
    "proxy|proxy|3128|http-connect|caching HTTP/S proxy (Squid, allowlisted domains)|set HTTP_PROXY=http://proxy:3128",
    "git-mirror|${GIT_HOST}|9418|git|bare mirror + auto-push to remote|git clone git://${GIT_HOST}/<project>",
    "inference|inference|11434|http|local ollama API|curl http://inference:11434/api/tags",
}

-- Per-project router (host-side; not enclave-resolvable from the forge).
local ROUTER_HOST, ROUTER_PORT = "opencode.<project>.localhost", 8080
local ROUTER_DESC = "per-project router (open from host browser)"

local function quote(s) return "'" .. s:gsub("'", "'\\''") .. "'" end
local function succeeds(cmd) return os.execute(cmd) == true end
local have_nc = succeeds("command -v nc >/dev/null 2>&1")
local function probe(host, port)
    local cmd
    if have_nc then
        cmd = ("nc -z -w 1 %s %s 2>/dev/null"):format(quote(host), port)
    else
        cmd = ("bash -c 'exec 3<>\"/dev/tcp/$1/$2\"' _ %s %s 2>/dev/null"):format(quote(host), port)
    end
    return succeeds(cmd) and "up" or "unreachable"
end

local services = {}
for _, entry in ipairs(SERVICES) do
    local line = entry:gsub("%${GIT_HOST}", function() return GIT_HOST end)
    local name, host, port, proto, desc, hint = line:match("^([^|]*)|([^|]*)|([^|]*)|([^|]*)|([^|]*)|(.*)$")
    services[#services + 1] = { name = name, host = host, port = port, proto = proto, desc = desc, hint = hint, status = probe(host, port) }
end

if mode == "--json" then
    local function str(s)
        return '"' .. s:gsub('[%c"\\\127]', function(c)
            if c == '"' or c == "\\" then return "\\" .. c end
            return ("\\u%04x"):format(c:byte())
        end) .. '"'
    end
    local rows = {}
    for i, s in ipairs(services) do
        rows[i] = ('{"name":%s,"host":%s,"port":%s,"protocol":%s,"status":%s,"description":%s,"hint":%s}'):format(
            str(s.name), str(s.host), s.port, str(s.proto), str(s.status), str(s.desc), str(s.hint))
    end
    io.stdout:write(('{"services":[%s],"router":{"host":%s,"port":%d,"status":"host-only","protocol":"http","description":%s}}\n'):format(
        table.concat(rows, ","), str(ROUTER_HOST), ROUTER_PORT, str(ROUTER_DESC)))
else
    local ROW = "  %-13s %-26s %-12s %-12s %s\n"
    io.stdout:write("Tillandsias enclave services\n\n" .. ROW:format("NAME", "ADDRESS", "STATUS", "PROTOCOL", "DESCRIPTION"))
    for _, s in ipairs(services) do io.stdout:write(ROW:format(s.name, s.host .. ":" .. s.port, s.status, s.proto, s.desc)) end
    io.stdout:write(ROW:format("router", ROUTER_HOST .. ":" .. ROUTER_PORT, "host-only", "http", ROUTER_DESC) .. "\nHints\n")
    for _, s in ipairs(services) do io.stdout:write(("  %-13s %s\n"):format(s.name, s.hint)) end
end
