#!/usr/bin/env lua
-- tillandsias-inventory — list every dev-runtime + version baked into the
-- forge image. Default plain-text columns; --json for machine consumption.
-- Tools that aren't present are silently skipped (the inventory shows what
-- is THERE). To request a missing tool, file a RUNTIME_LIMITATIONS_NNN.md.
--
-- Usage: tillandsias-inventory [--json]
--
-- @trace spec:forge-environment-discoverability, order:2380-ds8v
-- @cheatsheet runtime/forge-paths-ephemeral-vs-persistent.md
--
-- Stock Lua 5.4. A pipe or a spawn runs through sh: only the fixed tool names below are
-- put in a command line.

local HELP = [[
tillandsias-inventory — list every dev-runtime + version baked into the
forge image. Default plain-text columns; --json for machine consumption.
Tools that aren't present are silently skipped (the inventory shows what
is THERE). To request a missing tool, file a RUNTIME_LIMITATIONS_NNN.md.

Usage: tillandsias-inventory [--json]

@trace spec:forge-environment-discoverability
]]

local mode = arg[1] or ""
if mode == "-h" or mode == "--help" then io.stdout:write(HELP); os.exit(0) end
if mode ~= "" and mode ~= "--json" then
    io.stderr:write("tillandsias-inventory: unknown arg '" .. mode .. "'\nusage: tillandsias-inventory [--json]\n")
    os.exit(2)
end

-- Category catalogue — declaration order = display order.
-- Format: "Category|tool tool tool ..."
local CATEGORIES = {
    "Languages|java javac python3 node go cargo rustc dart flutter",
    "Build|mvn gradle npm yarn pnpm pipx uv poetry make cmake ninja nix",
    "Test|pytest junit chromium-headless firefox chromedriver geckodriver",
    "Utils|jq yq protoc grpcurl shellcheck shfmt rg fd fzf curl wget git gh xmlstarlet direnv",
    "Agents|claude opencode openspec",
    "Web/API|curl wget grpcurl gh",
}

local function first_line(cmd)
    local p = io.popen(cmd)
    local l = p:read("l") or ""
    p:read("a") -- drained: a closed pipe would SIGPIPE the tool
    p:close()
    return l
end
-- First line of `<tool> --version` (merged stderr; java prints to stderr).
local function short_version(tool)
    local v = first_line(tool .. " --version 2>&1 </dev/null"):gsub("\t", " "):gsub(" +", " "):gsub("^%s+", ""):gsub("%s+$", "")
    return v ~= "" and v or "(unknown)"
end

local found = {}
for _, entry in ipairs(CATEGORIES) do
    local category, tools = entry:match("^(.-)|(.*)$")
    local rows = {}
    for tool in tools:gmatch("%S+") do
        local path = first_line("command -v " .. tool .. " 2>/dev/null")
        if path ~= "" then rows[#rows + 1] = { tool = tool, version = short_version(tool), path = path } end
    end
    found[#found + 1] = { category = category, rows = rows }
end
local image = os.getenv("TILLANDSIAS_IMAGE_VERSION") or ""

if mode == "--json" then
    local function str(s)
        return '"' .. s:gsub('[%c"\\\127]', function(c)
            if c == '"' or c == "\\" then return "\\" .. c end
            return ("\\u%04x"):format(c:byte())
        end) .. '"'
    end
    local parts = { '"image_version":' .. str(image ~= "" and image or "unset") }
    for _, f in ipairs(found) do
        local rows = {}
        for i, r in ipairs(f.rows) do rows[i] = ('{"tool":%s,"version":%s,"path":%s}'):format(str(r.tool), str(r.version), str(r.path)) end
        parts[#parts + 1] = str((f.category:lower():gsub("[ /]", "_"))) .. ":[" .. table.concat(rows, ",") .. "]"
    end
    io.stdout:write("{" .. table.concat(parts, ",") .. "}\n")
else
    io.stdout:write(("Tillandsias forge inventory — image v%s\n\n"):format(image ~= "" and image or "unset"))
    for _, f in ipairs(found) do
        if #f.rows > 0 then
            io.stdout:write(f.category .. "\n")
            for _, r in ipairs(f.rows) do io.stdout:write(("  %-22s %-40s %s\n"):format(r.tool, r.version, r.path)) end
            io.stdout:write("\n")
        end
    end
end
