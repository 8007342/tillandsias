#!/usr/bin/env lua
-- tillandsias-logs — query external logs published by enclave service containers.
--
-- Usage:
--   tillandsias-logs ls                   List all roles + files with size + mtime
--   tillandsias-logs tail <role> <file>   Follow a specific log file (Ctrl-C to stop)
--   tillandsias-logs combine              Interleave forge-internal + all external logs
--
-- Stock Lua 5.4 (order 2392-kww7). Directory walks and the follow still run as
-- shell commands (the same glob order the shell version saw); every value that
-- reaches one is single-quoted by q(), never spliced.
--
-- @trace spec:external-logs-layer, order:2392-kww7
-- @cheatsheet runtime/forge-paths-ephemeral-vs-persistent.md

local function q(s) return "'" .. tostring(s):gsub("'", "'\\''") .. "'" end
local function sh(script)
    local h = io.popen("sh -c " .. q(script))
    local o = h:read("a") or ""
    local _, _, code = h:close()
    return o, code or 0
end
local function out(...) io.stdout:write(...) end
local function err(...) io.stderr:write(...) end
local function test(flag, p) local _, c = sh("[ " .. flag .. " " .. q(p) .. " ]"); return c == 0 end

local e = os.getenv("TILLANDSIAS_EXTERNAL_LOGS")
local EXTERNAL = (e and e ~= "") and e or "/var/log/tillandsias/external"
local INTERNAL = "/var/log/tillandsias"

local function usage()
    out("tillandsias-logs — query external logs from enclave service containers\n\n",
        "Usage:\n",
        "  tillandsias-logs ls                    List all roles + files (size, age)\n",
        "  tillandsias-logs tail <role> <file>    Follow a log file with [role/file] prefix\n",
        "  tillandsias-logs combine               Interleave internal + external logs (last 50 lines)\n",
        "\n",
        "Environment:\n",
        "  TILLANDSIAS_EXTERNAL_LOGS  Override external log root (default: " .. EXTERNAL .. ")\n",
        "\n",
        "Examples:\n",
        "  tillandsias-logs ls\n",
        "  tillandsias-logs tail git-service git-push.log\n",
        "  tillandsias-logs combine\n")
    os.exit(0)
end

-- Pretty-print a size in bytes as human-readable.
local function human_size(bytes)
    if bytes >= 1048576 then return string.format("%dM", bytes // 1048576)
    elseif bytes >= 1024 then return string.format("%dK", bytes // 1024) end
    return string.format("%dB", bytes)
end

local function age_text(age)
    if age < 60 then return string.format("%ds ago", age)
    elseif age < 3600 then return string.format("%dm ago", age // 60)
    elseif age < 86400 then return string.format("%dh ago", age // 3600) end
    return string.format("%dd ago", age // 86400)
end

-- Every file directly under each role dir of EXTERNAL, in glob order, as
-- "role\tfile\tsize\tmtime\tnow" (mtime "?" when stat cannot answer; the
-- ls -l columns follow then instead).
local function external_files()
    local o = sh("E=" .. q(EXTERNAL) .. "\n" .. [[
for role_dir in "$E"/*/; do
  [ -d "$role_dir" ] || continue
  role="$(basename "$role_dir")"
  for f in "$role_dir"*; do
    [ -f "$f" ] || continue
    size="$(wc -c < "$f" 2>/dev/null || printf 0)"
    if m="$(stat -c '%Y' "$f" 2>/dev/null)"; then a="$m	$(date +%s)"
    else a="?	$(ls -l "$f" 2>/dev/null | awk '{print $6, $7, $8}' || printf '?')"; fi
    printf '%s\t%s\t%s\t%s\n' "$role" "$(basename "$f")" "$size" "$a"
  done
done]])
    local rows = {}
    for line in o:gmatch("([^\n]*)\n") do
        local role, fname, size, m, rest = line:match("^([^\t]*)\t([^\t]*)\t([^\t]*)\t([^\t]*)\t(.*)$")
        if role then rows[#rows + 1] = { role = role, fname = fname, size = tonumber((size:gsub("%s", ""))) or 0, m = m, rest = rest } end
    end
    return rows
end

local function cmd_ls()
    if not test("-d", EXTERNAL) then
        out("No external logs found at " .. EXTERNAL .. "\n",
            "(forge containers must have external_logs_consumer=true and at least one producer running)\n")
        return
    end
    local last_role
    local rows = external_files()
    for _, r in ipairs(rows) do
        local age = r.m == "?" and r.rest or age_text(tonumber(r.rest) - tonumber(r.m))
        if r.role ~= last_role then
            out(string.format("%-22s : %-28s (%s, %s)\n", r.role, r.fname, human_size(r.size), age))
            last_role = r.role
        else
            out(string.format("%-22s   %-28s (%s, %s)\n", "", r.fname, human_size(r.size), age))
        end
    end
    if #rows == 0 then out("No log files found under " .. EXTERNAL .. "\n") end
end

local function cmd_tail(role, file)
    role, file = role or "", file or ""
    if role == "" or file == "" then
        err("usage: tillandsias-logs tail <role> <file>\n"); os.exit(2)
    end
    local log_path = EXTERNAL .. "/" .. role .. "/" .. file
    if not test("-f", log_path) then
        err("tillandsias-logs: " .. log_path .. " not found\n",
            "  Run `tillandsias-logs ls` to see available roles and files.\n")
        os.exit(1)
    end
    -- Follow, prefixing every line; each line is written as it arrives.
    local prefix = "[" .. role .. "/" .. file .. "] "
    local h = io.popen("tail -f " .. q(log_path))
    for line in h:lines() do out(prefix, line, "\n"); io.stdout:flush() end
    h:close()
end

local function cmd_combine()
    -- Every internal *.log then *.txt, then every external role file, each
    -- line tagged [where/file]; the last 50 tagged lines are printed.
    local o = sh("I=" .. q(INTERNAL) .. " E=" .. q(EXTERNAL) .. "\n" .. [[
if [ -d "$I" ]; then
  for f in "$I"/*.log "$I"/*.txt; do
    [ -f "$f" ] || continue
    awk -v pfx="[internal/$(basename "$f")]" '{ print pfx " " $0 }' "$f" 2>/dev/null || true
  done
fi
if [ -d "$E" ]; then
  for role_dir in "$E"/*/; do
    [ -d "$role_dir" ] || continue
    role="$(basename "$role_dir")"
    for f in "$role_dir"*; do
      [ -f "$f" ] || continue
      awk -v pfx="[$role/$(basename "$f")]" '{ print pfx " " $0 }' "$f" 2>/dev/null || true
    done
  done
fi]])
    if o == "" then
        out("No log content found (internal: " .. INTERNAL .. ", external: " .. EXTERNAL .. ")\n")
        return
    end
    local lines = {}
    for l in o:gmatch("([^\n]*)\n") do lines[#lines + 1] = l end
    for i = math.max(1, #lines - 49), #lines do out(lines[i], "\n") end
end

local cmd = arg[1] or ""
if cmd == "ls" then cmd_ls()
elseif cmd == "tail" then cmd_tail(arg[2], arg[3])
elseif cmd == "combine" then cmd_combine()
elseif cmd == "-h" or cmd == "--help" or cmd == "" then usage()
else
    err("tillandsias-logs: unknown subcommand: " .. cmd .. "\n", "Run `tillandsias-logs --help` for usage.\n")
    os.exit(2)
end
