#!/usr/bin/env bash
# tellme — search and lookup cheatsheets and dependency references in the forge.
#
# Usage: tellme about <topic> [--full]
#        tellme about "<free-form question>"
#        tellme about --list
#        tellme howto "<query>"
#        tellme --help
#
# @trace spec:forge-environment-discoverability, spec:expert-serve-grounded-pipeline
# @trace order:1814-x78v
# @cheatsheet runtime/cheatsheet-architecture-v2.md, runtime/cheatsheet-frontmatter-spec.md

set -euo pipefail

# Find cheatsheets directory
cheatsheets_dir="${TILLANDSIAS_CHEATSHEETS:-/opt/cheatsheets}"
serving_note=""
if [ ! -d "$cheatsheets_dir" ] || [ ! -f "$cheatsheets_dir/INDEX.md" ]; then
    # 920-tqhs: the resolved dir is missing or hollow (an empty hot mount broke
    # tellme in-lane on 2026-08-28 while the lifecycle trace claimed the copy
    # succeeded). Fall back to the repo / image bundle and say which copy is
    # serving, so a degraded lane is diagnosable instead of a silent CLI break.
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
    if [ -n "${BASH_SOURCE[0]:-}" ] && [ -d "$SCRIPT_DIR/../cheatsheets" ] && [ -f "$SCRIPT_DIR/../cheatsheets/INDEX.md" ]; then
        cheatsheets_dir="$SCRIPT_DIR/../cheatsheets"
        serving_note="serving repo-local cheatsheets ($SCRIPT_DIR/../cheatsheets): requested dir ${TILLANDSIAS_CHEATSHEETS:-/opt/cheatsheets} lacks INDEX.md"
    elif [ -d "$SCRIPT_DIR/../../cheatsheets" ] && [ -f "$SCRIPT_DIR/../../cheatsheets/INDEX.md" ]; then
        cheatsheets_dir="$SCRIPT_DIR/../../cheatsheets"
        serving_note="serving repo-local cheatsheets ($SCRIPT_DIR/../../cheatsheets): requested dir ${TILLANDSIAS_CHEATSHEETS:-/opt/cheatsheets} lacks INDEX.md"
    elif [ -d /opt/cheatsheets-image ] && [ -f /opt/cheatsheets-image/INDEX.md ]; then
        cheatsheets_dir="/opt/cheatsheets-image"
        serving_note="serving the shipped image bundle (/opt/cheatsheets-image): requested dir ${TILLANDSIAS_CHEATSHEETS:-/opt/cheatsheets} lacks INDEX.md"
    fi
fi
[ -n "$serving_note" ] && printf 'tellme: %s\n' "$serving_note" >&2

INDEX_PATH="$cheatsheets_dir/INDEX.md"

# ── grounded answers through expert-serve (order 1814-x78v) ────────────────
# `howto` and free-form `about` ask expert-serve first: the OpenAI-shaped
# loopback front-end over the grounded pipeline (expert_serve.rs `route`,
# pipeline.rs `run_grounded`), started at forge launch by lib-common.sh
# `start_expert_serve_fail_soft`. It cites the chunks it retrieved and refuses
# typed below its threshold. The model id IS the retrieval domain:
# `cheatsheet` for howto, `all` for free-form about. Only when the port does
# not answer does tellme drop to the keyword-grep fallback, and it labels that
# answer UNGROUNDED.
EXPERT_URL="${TELLME_EXPERT_URL:-http://127.0.0.1:${TILLANDSIAS_EXPERT_SERVE_PORT:-11436}}"
EXPERT_URL="${EXPERT_URL%/}"

# The plan binary reads the reply (`json get`, a jq subset — no new jq call
# site, 1375-tsfu). It is the binary that serves expert-serve, so a forge with
# the port up has it; without it the grounded path reports itself unavailable.
tellme_plan_bin() {
    local c
    for c in "${TELLME_PLAN_BIN:-}" "$(command -v tillandsias-plan 2>/dev/null || true)" \
             "${FORGE_EXPERTS_BIN_DIR:-$HOME/.local/bin}/tillandsias-plan"; do
        if [ -n "$c" ] && [ -x "$c" ]; then
            printf '%s\n' "$c"
            return 0
        fi
    done
    return 1
}

# Order 1815-tei4: the project-derived context pack (.forge-expert-context.md,
# written at forge launch by lib-common.sh write_expert_context_pack) goes
# FIRST, byte-identical, in every synthesis prompt tellme builds: the pack's
# bytes, then the separator pipeline.rs uses (context_pack::PACK_SEPARATOR,
# pinned by the cargo test tellme_prints_the_same_pack_separator). Path:
# $TILLANDSIAS_EXPERT_CONTEXT_PACK, else beside the startup context, else in
# $PROJECT_DIR. FAIL-SOFT: absent, not a regular file, empty or oversized
# prints nothing and the prompt is unchanged. Callers capture it with a
# trailing sentinel so command substitution keeps its trailing newlines.
tellme_context_pack() {
    local pack="${TILLANDSIAS_EXPERT_CONTEXT_PACK:-}" size
    if [ -z "$pack" ]; then
        if [ -n "${FORGE_STARTUP_CONTEXT_FILE:-}" ]; then
            pack="$(dirname "$FORGE_STARTUP_CONTEXT_FILE")/.forge-expert-context.md"
        elif [ -n "${PROJECT_DIR:-}" ]; then
            pack="$PROJECT_DIR/.forge-expert-context.md"
        else
            return 0
        fi
    fi
    [ -f "$pack" ] && [ -r "$pack" ] || return 0
    size="$(wc -c < "$pack" 2>/dev/null | tr -d ' ')" || return 0
    # Same bounds as context_pack::load_pack_from: non-empty, <= 2 x 4800 bytes.
    [ -n "$size" ] && [ "$size" -gt 0 ] && [ "$size" -le 9600 ] || return 0
    head -c 9600 "$pack" || return 0
    printf '\n---\n\n'
}

# expert_serve_ask <model> <question> — 0 when expert-serve answered (answer
# and citations printed on stdout), 1 when the port did not answer or the
# reply was unusable (nothing on stdout; the caller falls back).
expert_serve_ask() {
    local model="$1" question="$2" plan q_json payload reply answer cites c_path c_start c_end
    curl -fsS --max-time "${TELLME_EXPERT_PROBE_TIMEOUT:-1}" "$EXPERT_URL/v1/models" >/dev/null 2>&1 || return 1
    if ! plan="$(tellme_plan_bin)"; then
        echo "tellme: expert-serve answers at $EXPERT_URL but no tillandsias-plan binary is installed to read its reply" >&2
        return 1
    fi
    # The question is JSON-escaped by the plan binary; the object around it is
    # assembled in shell (`json get` constructs no objects).
    q_json="$("$plan" json get -n -c --arg q "$question" '$q')" || return 1
    payload='{"model":"'"$model"'","stream":false,"messages":[{"role":"user","content":'"$q_json"'}]}'
    if ! reply="$(curl -fsS --max-time "${TELLME_EXPERT_TIMEOUT:-120}" -X POST "$EXPERT_URL/v1/chat/completions" \
        -H "Content-Type: application/json" -d "$payload" 2>/dev/null)"; then
        echo "tellme: expert-serve at $EXPERT_URL did not complete the request" >&2
        return 1
    fi
    answer="$(printf '%s' "$reply" | "$plan" json get -r '.choices[0].message.content // empty' 2>/dev/null)" || answer=""
    if [ -z "$answer" ]; then
        echo "tellme: expert-serve at $EXPERT_URL returned no answer content" >&2
        return 1
    fi
    cites="$(printf '%s' "$reply" | "$plan" json get -r '.tillandsias_envelope.citations[]? | .path, .line_start, .line_end' 2>/dev/null | paste - - -)" || cites=""
    printf '\033[1;30m[expert-serve: grounded answer, model %s, %s]\033[0m\n\n' "$model" "$EXPERT_URL"
    printf '%s\n\n' "$answer"
    if [ -n "$cites" ]; then
        echo "Sources:"
        while IFS=$'\t' read -r c_path c_start c_end; do
            [ -n "$c_path" ] || continue
            printf '  - %s:%s-%s\n' "$c_path" "$c_start" "$c_end"
        done <<< "$cites"
    else
        echo "Sources: none cited (a typed refusal cites nothing)"
    fi
    return 0
}

show_help() {
    echo "Usage: tellme about <topic> [--full]"
    echo "       tellme about \"<free-form question>\""
    echo "       tellme about --list"
    echo "       tellme howto \"<query>\""
    echo "       tellme --help"
    echo ""
    echo "Options:"
    echo "  --list    Show all categories of cheatsheets"
    echo "  --full    Show full content of the matching cheatsheet"
    echo "  -h|--help Show this help message"
    echo ""
    echo "Examples:"
    echo "  tellme about languages"
    echo "  tellme about python"
    echo "  tellme about git-workflows --full"
    echo "  tellme howto \"how do I run python unit tests\""
    echo "  tellme about \"how do I push from the forge\""
    echo ""
    echo "howto and free-form about answer through expert-serve ($EXPERT_URL), with"
    echo "citations. When it does not answer, howto falls back to a keyword search of"
    echo "the cheatsheet index and labels that answer UNGROUNDED."
}

if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;
    howto)
        if [ -z "${2:-}" ]; then
            echo "tellme howto: query missing" >&2
            echo "usage: tellme howto \"<query>\"" >&2
            exit 2
        fi
        query="$2"

        # Grounded first (1814-x78v): expert-serve's cheatsheet domain.
        if expert_serve_ask cheatsheet "$query"; then
            exit 0
        fi

        # FALLBACK — expert-serve did not answer. The keyword-grep context
        # below is not retrieval with a refusal threshold, so the answer is
        # labelled UNGROUNDED and the prompt forbids guessing past the context.
        INFERENCE_URL="${TILLANDSIAS_INFERENCE_URL:-http://inference:11434}"
        
        # Verify inference service is reachable and get models
        raw_models="$(curl -fsS --max-time 3 "${INFERENCE_URL%/}/api/tags" 2>/dev/null || true)"
        if [ -z "$raw_models" ]; then
            echo "Error: inference container not running (${INFERENCE_URL%/}/api/tags unreachable)" >&2
            exit 1
        fi
        
        models_list=$(echo "$raw_models" | jq -r '.models[].name' 2>/dev/null || true)
        if [ -z "$models_list" ]; then
            echo "Error: no models loaded at $INFERENCE_URL" >&2
            exit 1
        fi
        
        # Select model: TILLANDSIAS_INFERENCE_MODEL when set (the variable
        # pipeline.rs and lib-common.sh already honour), else qwen2.5:0.5b,
        # then llama3.2:3b, then the first loaded model.
        chosen_model="${TILLANDSIAS_INFERENCE_MODEL:-}"
        for m in qwen2.5:0.5b llama3.2:3b; do
            [ -z "$chosen_model" ] || break
            if echo "$models_list" | grep -q "^$m$"; then
                chosen_model="$m"
                break
            fi
        done
        if [ -z "$chosen_model" ]; then
            chosen_model=$(echo "$models_list" | head -n 1)
        fi
        
        # 1. RAG Context Building
        # Extract alphanumeric keywords from query, lowercase them, ignore small words/stop words
        keywords=$(echo "$query" | tr -cs 'a-zA-Z0-9' ' ' | tr 'A-Z' 'a-z' | xargs -n1 | awk 'length($0) > 2' | sed -E 's/(ing|ed|s|es)$//' | sort -u)
        
        matching_files=()
        if [ -n "$keywords" ] && [ -f "$INDEX_PATH" ]; then
            # Find matching cheatsheets, boosting filename matches
            matching_lines=$(echo "$keywords" | while read -r kw; do
                [ -n "$kw" ] || continue
                grep -i -- "- .*$kw" "$INDEX_PATH" || true
                grep -i -- "- *$kw.*\.md" "$INDEX_PATH" || true
                grep -i -- "- *$kw.*\.md" "$INDEX_PATH" || true
            done | sort | uniq -c | sort -nr)
            
            if [ -n "$matching_lines" ]; then
                while IFS= read -r line; do
                    f=$(echo "$line" | sed -E 's/^[[:space:]]*[0-9]+[[:space:]]+-[[:space:]]+([^[:space:]]+).*/\1/')
                    if [ -n "$f" ]; then
                        matching_files+=("$f")
                    fi
                done <<< "$matching_lines"
            fi
        fi
        
        # Build context from top 3 cheatsheets (first 100 lines after frontmatter)
        context=""
        count=0
        for f in "${matching_files[@]}"; do
            [ $count -ge 3 ] && break
            if [ -f "$cheatsheets_dir/$f" ]; then
                file_content=$(head -n 120 "$cheatsheets_dir/$f" | awk 'NR==1 && /^---$/ { fm=1; next } fm && /^---$/ { fm=0; next } fm { next } { print }' | head -n 100)
                if [ -n "$file_content" ]; then
                    context+=$'\n'
                    context+="=== Cheatsheet: $f ==="$'\n'
                    context+="$file_content"$'\n'
                    count=$((count+1))
                fi
            fi
        done
        
        # Print info about model and cheatsheets used
        echo -e "\033[1;30m[UNGROUNDED: expert-serve not answering at $EXPERT_URL; keyword-search fallback, no citations]\033[0m"
        echo -e "\033[1;30m[Using model: $chosen_model]\033[0m"
        if [ $count -gt 0 ]; then
            echo -e "\033[1;30m[Context: top $count keyword-matched cheatsheet(s)]\033[0m"
        else
            echo -e "\033[1;30m[Context: no matching cheatsheets]\033[0m"
        fi
        echo ""

        # Format the system prompt and context. The context pack (1815-tei4)
        # leads it byte-identically; the `.` sentinel keeps the separator's
        # trailing newlines through the command substitution.
        pack_prefix="$(tellme_context_pack; printf .)"
        pack_prefix="${pack_prefix%.}"
        prompt="${pack_prefix}System: You are an expert developer assistant for the Tillandsias Forge.
Using only the following cheatsheet context, answer the user's question concisely. If the context does not contain the answer, say that the cheatsheets do not cover it and suggest 'tellme about --list'; do not guess. Keep your response brief, action-oriented, and focused on command/code snippets.

Context:
$context

User: $query
Assistant:"
        
        # Safe JSON generation using jq
        payload=$(jq -n \
          --arg model "$chosen_model" \
          --arg prompt "$prompt" \
          '{model: $model, prompt: $prompt, stream: true}')
        
        # Call curl and stream response to stdout
        curl -s -N -X POST "${INFERENCE_URL%/}/api/generate" \
          -H "Content-Type: application/json" \
          -d "$payload" | \
          jq -j --unbuffered '.response' | tr -d '\r'
        
        echo ""
        ;;
    about)
        if [ -z "${2:-}" ]; then
            echo "tellme about: topic or flag missing" >&2
            echo "usage: tellme about <topic> [--full] or tellme about --list" >&2
            exit 2
        fi
        
        if [ "$2" = "--list" ]; then
            if [ ! -f "$INDEX_PATH" ]; then
                echo "Error: Cheatsheet index not found at $INDEX_PATH" >&2
                exit 1
            fi
            grep '^## ' "$INDEX_PATH" | sed 's/^## //'
            exit 0
        fi
        
        topic="$2"
        full=0
        if [ "${3:-}" = "--full" ] || [ "${3:-}" = "-f" ]; then
            full=1
        fi

        # Free-form about (1814-x78v): a question rather than a topic slug —
        # whitespace in the topic, or several words — goes to expert-serve's
        # `all` domain. A slug keeps the index lookup below.
        if [ $full -eq 0 ]; then
            question="$topic"
            [ $# -le 2 ] || question="${*:2}"
            case "$question" in
                *[[:space:]]*)
                    if expert_serve_ask all "$question"; then
                        exit 0
                    fi
                    # Port closed: the howto fallback, which labels itself
                    # UNGROUNDED. An index slug search cannot answer a sentence.
                    exec bash "${BASH_SOURCE[0]:-$0}" howto "$question"
                    ;;
            esac
        fi

        # 1. Handle dependencies special topic
        is_dep_query=0
        if [[ "$topic" =~ ^(dependency|dependencies|package|packages)$ ]]; then
            is_dep_query=1
            echo "Tillandsias Forge Dependency Reference:"
            echo "The forge image builds on Fedora minimal. Main system dependencies:"
            echo "  - Languages: Java 25, Python 3.13, Node 22, Go, Rust (cargo), Dart (flutter)"
            echo "  - Build tools: Maven, Gradle, npm, yarn, pnpm, pipx, uv, poetry, make, cmake, ninja, nix"
            echo "  - Test frameworks: pytest, junit, cargo-test, chromium-headless, firefox"
            echo "  - Utils: jq, yq, protoc, grpcurl, shellcheck, shfmt, rg, fd, fzf, curl, wget, git, gh, xmlstarlet"
            echo "  - Agent tools: claude-code, opencode, openspec, codex"
            echo ""
            echo "For the exact version and binary paths of these dependencies, run:"
            echo "  tillandsias-inventory"
            echo ""
            echo "For enclave services:"
            echo "  tillandsias-services"
            echo "--------------------------------------------------------"
        fi
        
        if [ ! -f "$INDEX_PATH" ]; then
            echo "Error: Cheatsheet index not found at $INDEX_PATH" >&2
            exit 1
        fi
        
        if [ $full -eq 1 ]; then
            # Find matching cheatsheet files
            # Check exact file matches first
            matches=()
            if [ -f "$cheatsheets_dir/$topic" ]; then
                matches+=("$cheatsheets_dir/$topic")
            elif [ -f "$cheatsheets_dir/$topic.md" ]; then
                matches+=("$cheatsheets_dir/$topic.md")
            else
                # Search recursively for matching filename
                while IFS= read -r -d '' file; do
                    matches+=("$file")
                done < <(find "$cheatsheets_dir" -type f -iname "*${topic}*.md" -print0 2>/dev/null)
            fi
            
            # De-duplicate matches
            unique_matches=()
            for m in "${matches[@]}"; do
                found_match=0
                for um in "${unique_matches[@]}"; do
                    if [ "$um" = "$m" ]; then
                        found_match=1
                        break
                    fi
                done
                if [ $found_match -eq 0 ]; then
                    unique_matches+=("$m")
                fi
            done
            
            if [ ${#unique_matches[@]} -eq 0 ]; then
                echo "No cheatsheet found matching '$topic'." >&2
                exit 1
            elif [ ${#unique_matches[@]} -eq 1 ]; then
                if command -v bat >/dev/null 2>&1; then
                    bat --style=plain "${unique_matches[0]}"
                else
                    cat "${unique_matches[0]}"
                fi
                exit 0
            else
                echo "Multiple matching cheatsheets found for '$topic':"
                for m in "${unique_matches[@]}"; do
                    rel="${m#$cheatsheets_dir/}"
                    echo "  - $rel"
                done
                echo "Please specify a more specific name, e.g.:"
                rel_example="${unique_matches[0]#$cheatsheets_dir/}"
                base_example="$(basename "$rel_example" .md)"
                echo "  tellme about $base_example --full"
                exit 1
            fi
        else
            # Print category section if topic matches a category name exactly
            category_match=$(grep -Ei "^## $topic$" "$INDEX_PATH" || true)
            if [ -n "$category_match" ]; then
                awk -v category="$topic" '
                  BEGIN { IGNORECASE = 1; found = 0 }
                  $0 ~ "^## " category "$" { found = 1; print; next }
                  found && /^## / { found = 0 }
                  found { print }
                ' "$INDEX_PATH"
                exit 0
            fi
            
            # Substring match categories or cheatsheet lines
            search_results=$(awk -v topic="$topic" '
              BEGIN { IGNORECASE = 1; current_cat = ""; cat_printed = 0 }
              /^## / { current_cat = substr($0, 4); cat_printed = 0; next }
              /^- / {
                if ($0 ~ topic) {
                  if (!cat_printed && current_cat != "") {
                    print "\n## " current_cat
                    cat_printed = 1
                  }
                  print $0
                }
              }
            ' "$INDEX_PATH")
            
            if [ -n "$search_results" ]; then
                printf '%s\n' "$search_results"
            else
                if [ $is_dep_query -eq 1 ]; then
                    exit 0
                fi
                echo "No matching cheatsheets or categories found for '$topic'." >&2
                echo "Run 'tellme about --list' to see all categories." >&2
                exit 1
            fi
        fi
        ;;
    *)
        echo "tellme: unknown command/option '${1:-}'" >&2
        echo "usage: tellme about <topic> [--full] or tellme about --list" >&2
        exit 2
        ;;
esac
