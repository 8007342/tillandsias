{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "build",
  "permission": "allow",
  "model": "opencode/big-pickle",
  "small_model": "opencode/gpt-5-nano",
  "instructions": [
    "/home/forge/.config-overlay/opencode/instructions/methodology.md",
    "/home/forge/.config-overlay/opencode/instructions/forge-discovery.md",
    "/home/forge/.config-overlay/opencode/instructions/cache-discipline.md",
    "/home/forge/.config-overlay/opencode/instructions/nix-first.md",
    "/home/forge/.config-overlay/opencode/instructions/openspec-workflow.md",
    "/home/forge/.config-overlay/opencode/instructions/flutter.md",
    "/home/forge/.config-overlay/opencode/instructions/model-routing.md",
    "/home/forge/.config-overlay/opencode/instructions/web-services.md"
  ],
  "agent": {
    "local-experts": {
      "model": "ollama/qwen2.5:14b",
      "description": "EXPERIMENTAL: raw local-model answers with no retrieval or validation — not yet wired through the grounded pipeline (packet wire-local-experts-mode-through-grounded-pipeline).",
      "mode": "primary",
      "prompt": "You are running in Local Experts mode. This mode is EXPERIMENTAL and NOT yet wired through the grounded pipeline (packet wire-local-experts-mode-through-grounded-pipeline): your answers are raw local-model output with NO retrieval, NO domain-separated RAG, and NO validation.\n\nRules:\n- When asked about project specifics, say plainly that this mode is ungrounded and your answer may be wrong.\n- Direct grounded questions to the forge-plan MCP tools (spec_answer, plan_answer, methodology_ask) where available.\n- NEVER fabricate file paths, section names, or citations. Do not cite sources you did not read.\n- If you cannot answer confidently, say so."
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://inference:11434/v1"
      },
      "models": {
        "qwen2.5:0.5b": { "name": "Qwen 2.5 0.5B (local)" },
        "qwen2.5:7b": { "name": "Qwen 2.5 7B (local)" },
        "qwen2.5:14b": { "name": "Qwen 2.5 14B (local)" },
        "qwen2.5-coder:7b": { "name": "Qwen 2.5 Coder 7B (local)" },
        "qwen2.5-coder:14b": { "name": "Qwen 2.5 Coder 14B (local)" },
        "qwen2.5-coder:32b": { "name": "Qwen 2.5 Coder 32B (local)" },
        "llama3.2:1b": { "name": "LLaMA 3.2 1B (local)" },
        "llama3.2:3b": { "name": "LLaMA 3.2 3B (local)" },
        "llama3.1:8b": { "name": "LLaMA 3.1 8B (local)" },
        "gpt-oss:20b": { "name": "GPT-OSS 20B (local)" }
      }
    }
  },
  "mcp": {
    "git-tools": {
      "type": "local",
      "command": ["/home/forge/.config-overlay/mcp/git-tools.sh"],
      "enabled": true
    },
    "project-info": {
      "type": "local",
      "command": ["/home/forge/.config-overlay/mcp/project-info.sh"],
      "enabled": true
    },
    "host-browser": {
      "type": "local",
      "command": ["/home/forge/.config-overlay/mcp/host-browser.sh"],
      "enabled": true
    },
    "forge-plan": {
      "type": "local",
      "command": ["/home/forge/.config-overlay/mcp/forge-plan.sh"],
      "enabled": true
    }
  },
  "lsp": true
}
