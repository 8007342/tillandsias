# Tillandsias Forge — Fedora Minimal Base
# Heavy dependencies cached to improve rapid rebuilds of the final image.
# @trace spec:default-image
# Developer UX tools: fzf, eza, htop, mc, tree, nano, vim-minimal for interactive use.
FROM registry.fedoraproject.org/fedora-minimal:44
# 1958-yfib: the image inherits its base layer's labels, so without this line it ships
# the base's licence as ours (measured: fedora-minimal -> MIT, caddy -> Apache-2.0). The
# label is Tillandsias's own recipe; every base image and package it carries is
# credited, with its upstream licence, in docs/credits/stack.v1.json.
LABEL org.opencontainers.image.licenses="GPL-3.0-or-later"

# ── System packages ────────────────────────────────────────────
# glibc-langpack-en: the image declares `ENV LANG=en_US.UTF-8` (Containerfile) but
# Fedora-minimal ships only C/C.utf8/POSIX. Without this langpack the locale
# silently degrades to ASCII — `locale` errors "Cannot set LC_CTYPE" — garbling
# UTF-8 in the terminal AND in file I/O, and making tool output non-deterministic
# (the encoding "flip-flop"). Root-caused by Big Pickle in-forge:
# plan/issues/optimization/forge-locale-missing-glibc-langpack-2026-07-24.md.
RUN microdnf install -y --nogpgcheck --setopt=install_weak_deps=0 \
        glibc-langpack-en \
        bash coreutils findutils grep sed gawk tar gzip xz \
        which \
        procps-ng shadow-utils ca-certificates ncurses ncurses-term \
        fish zsh \
        git gh curl wget openssl jq ripgrep fd-find bat fzf eza htop mc tree nano vim-minimal zoxide git-delta git-lfs httpie yq \
        nodejs npm \
        java-25-openjdk-headless maven \
        golang gopls \
        rust cargo clippy rustfmt rust-analyzer cargo-deny \
        rust-std-static-wasm32-unknown-unknown \
        python3-pip python3-mypy python3-pytest python3-lsp-server \
        ruff poetry pipx uv black pylint yamllint \
        pnpm yarnpkg \
        just \
        gdb lldb strace ltrace valgrind heaptrack delve \
        shellcheck shfmt \
        gcc gcc-c++ make cmake pkgconfig unzip \
        diffutils patch file gettext diffstat \
        iproute iputils socat nmap-ncat sqlite \
        inotify-tools \
        lua lua-filesystem lua-lpeg \
    && git lfs install --system \
    && microdnf clean all \
    && rustc_v="$(rpm -q --qf '%{VERSION}-%{RELEASE}' rust)" \
    && std_v="$(rpm -q --qf '%{VERSION}-%{RELEASE}' rust-std-static-wasm32-unknown-unknown)" \
    && if [ "$rustc_v" != "$std_v" ]; then \
           echo "FATAL: rust-std-static-wasm32-unknown-unknown $std_v does not match rust $rustc_v" >&2; \
           exit 1; \
       fi \
    && test -d "$(rustc --print sysroot)/lib/rustlib/wasm32-unknown-unknown/lib"
# ↑ openssl (order 1780-jxc3): the openssl CLI. Tillandsias's own CA and preview
# CA code shells out to it, so its tests (ca_refresh_margin_tests, preview_ca,
# local_web_preview's leaf margin) need it to run in a forge, and a forge agent
# inspecting a certificate needs it too. Measured 2026-10-18: absent from the
# image, 10 headless tests failed `openssl: NotFound` in a forge from trunk.
# ↑ rust-std-static-wasm32-unknown-unknown (order 1625-grk8). The forge's Rust is
# Fedora's system rustc (no rustup), so `rustup target add` does not exist here and
# wasm-pack (FIRST_RUN, lib-common) could not build a wasm web project: `cargo build
# --target wasm32-unknown-unknown` failed "can't find crate for `std`" (visual-chess
# on yoga, 2026-10-12). Fedora builds the target std from the SAME rust source, so it
# must match the installed rustc exactly: the build refuses a mismatch rather than
# ship a std the compiler rejects (E0514), and checks the sysroot really has it.
# It is in THIS layer on purpose: a separate RUN rewrote the 56 MB rpm database
# into its own layer (measured 179 MB layer for a 113 MB package).

# ── Agent binaries ─────────────────────────────────────────────
# Agent harnesses are installed EVERY_LAUNCH by ensure_forge_harnesses
# (see lib-common.sh) — always latest, fail-soft to the persistent npm
# cache. No pinned versions at CREATION.
# @trace plan/issues/forge-harness-every-launch-latest-2026-07-04.md (order 181)

# ── Antigravity CLI (agy) ───────────────────────────────────────
# NOT installed at build: the upstream installer is a pipe-to-shell with a floating
# version (violates the image package-source policy + bakes the wrong arch on the
# aarch64 macOS guest). agy installs EVERY_LAUNCH from the Antigravity forge
# entrypoint instead (install-if-missing, timeout-guarded, latest).
# @trace plan/issues/forge-harness-every-launch-latest-2026-07-04.md (order 181)

# ── Python packages and developer tools ─────────────────────────
# Order 1771-4iw3: a WALL-CLOCK budget, because pip's --timeout is per read
# and multiplies by its attempts (measured 2026-10-17: --timeout 5 with the
# default 5 retries held a stalled index 43 s, so --timeout 120 held one stalled
# URL ~12 min, and `tillandsias --init` sat at 40% for 10-30 min on
# macuahuitl). (retries+1) x --timeout per URL fits inside the budget, and a
# stall fails the build with a named verdict instead of a frozen percentage.
# scripts/lua/test-forge-base-pip-bounded.lua runs this step's text.
ARG PIP_STALL_BUDGET_S=600
RUN rc=0; \
    timeout "${PIP_STALL_BUDGET_S}" pip3 install --timeout 30 --retries 2 --no-cache-dir \
        pyright==1.1.410 \
        bandit==1.9.2 \
        || rc=$?; \
    if [ "$rc" -eq 124 ]; then \
        echo "refused:forge-base:pip-install-stalled:budget=${PIP_STALL_BUDGET_S}s (step: pip3 install pyright bandit)"; \
        echo "  why: pip did not finish within the budget; a read from the package index stalled on this build's network"; \
        echo "  remedy: check that podman build reaches pypi.org from this host (IPv6 route, DNS, pasta vs slirp4netns), then run the build again"; \
        exit 1; \
    elif [ "$rc" -ne 0 ]; then \
        echo "refused:forge-base:pip-install-failed:rc=$rc (step: pip3 install pyright bandit)"; \
        echo "  why: pip exited non-zero; its own error is printed above"; \
        echo "  remedy: fix what pip names, then run the build again"; \
        exit 1; \
    fi; \
    npm install -g \
        typescript@6.0.3 \
        typescript-language-server@5.3.0 \
        prettier@3.8.3 \
        eslint@10.4.1 \
        markdownlint-cli@0.48.0

# ── Rust toolchain env (cargo dev-tools install at FIRST_RUN — see lib-common) ──
ENV CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

# Cargo dev-tools + nextest (order 188), actionlint/vale/wasmtime (order 180 slice 2),
# AND the Dart SDK (order 180 dart sub-slice) are NO LONGER installed at build — they
# all moved to an arch-aware, idempotent, fail-soft FIRST_RUN install (lib-common
# `ensure_forge_prebuilt_tools` + `ensure_dart_sdk`) into the order-179 persistent
# cache. This fixes the aarch64 macOS guest baking non-executable x86_64 binaries + the
# sequential-fetch build hang, and leaves forge-base CREATION microdnf + npm ONLY —
# no curl/tar/unzip archive-extraction chains remain. marksman (the last single-binary
# curl) also moved to FIRST_RUN in ensure_forge_prebuilt_tools (order 180 marksman
# sub-slice); Containerfile.base now contains zero asset download commands.
