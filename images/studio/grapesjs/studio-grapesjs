#!/usr/bin/env bash
# @trace order:1861-nmpp, order:1860-auhm, spec:web-studio-lane
# The GrapesJS lane's entry (registry.lua `entry`). It replaces the forge's
# OpenCode Web entrypoint: materialise the checkout exactly as that one does,
# serve the editor on loopback :4097, and exec the studio front on :4096, the
# port the router reaches. The front is the only writer.
set -euo pipefail
source /usr/local/lib/tillandsias/lib-common.sh
export TILLANDSIAS_STUDIO="${TILLANDSIAS_STUDIO:-grapesjs}"
clone_project_from_mirror
checkout="/home/forge/src/${TILLANDSIAS_PROJECT:?TILLANDSIAS_PROJECT names the project the studio edits}"
[ -d "$checkout/.git" ] || { echo "refused:studio-grapesjs:no-checkout:$checkout" >&2; exit 1; }

STUDIO_PROJECT="$checkout" STUDIO_HOST=127.0.0.1 STUDIO_PORT=4097 \
  node /opt/studio/grapesjs/server.mjs &
editor_pid=$!
trap 'kill "$editor_pid" 2>/dev/null || true' INT TERM EXIT

export LISTEN_PORT=4096 UPSTREAM=127.0.0.1:4097 STUDIO_CHECKOUT="$checkout"
exec node /opt/studio/studio-front.js
