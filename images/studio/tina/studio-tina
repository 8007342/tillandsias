#!/usr/bin/env bash
# @trace order:1863-dmke, order:1860-auhm, spec:web-studio-lane
# The TinaCMS lane's entry (registry.lua `entry`). Like studio-grapesjs: the
# checkout materialised as the OpenCode Web entrypoint does, the studio on
# loopback :4097 (it starts tinacms dev on [::1]:4001, its data layer on
# [::1]:9000), and the studio
# front exec'd on :4096, the port the router reaches.
set -euo pipefail
source /usr/local/lib/tillandsias/lib-common.sh
export TILLANDSIAS_STUDIO="${TILLANDSIAS_STUDIO:-tina}"
clone_project_from_mirror
checkout="/home/forge/src/${TILLANDSIAS_PROJECT:?TILLANDSIAS_PROJECT names the project the studio edits}"
[ -d "$checkout/.git" ] || { echo "refused:studio-tina:no-checkout:$checkout" >&2; exit 1; }

# Started outside the checkout: a studio's own caches must never land in it.
(cd /opt/studio/tina && \
  STUDIO_PROJECT="$checkout" STUDIO_HOST=127.0.0.1 STUDIO_PORT=4097 \
  exec node /opt/studio/tina/server.mjs) &
studio_pid=$!
trap 'kill "$studio_pid" 2>/dev/null || true' INT TERM EXIT

export LISTEN_PORT=4096 UPSTREAM=127.0.0.1:4097 STUDIO_CHECKOUT="$checkout"
cd /opt/studio
exec node /opt/studio/studio-front.js
