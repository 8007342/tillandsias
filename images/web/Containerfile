# @trace spec:web-image
# Reference only — images are built via flake.nix
# DISTRO: Alpine — busybox sh, no bash. Entrypoint uses #!/bin/sh (POSIX).
FROM docker.io/library/alpine:3.20

# DISTRO: apk (Alpine), NOT microdnf/dnf (Fedora)
RUN apk add --no-cache busybox-extras

# 2007-hear: audio MIME types for the static preview.
COPY httpd.conf /etc/httpd.conf
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /var/www

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
