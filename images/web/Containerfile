# @trace spec:web-image
# Reference only — images are built via flake.nix
# DISTRO: Alpine — busybox sh, no bash. Entrypoint uses #!/bin/sh (POSIX).
FROM docker.io/library/alpine:3.20
# 1958-yfib: the image inherits its base layer's labels, so without this line it ships
# the base's licence as ours (measured: fedora-minimal -> MIT, caddy -> Apache-2.0). The
# label is Tillandsias's own recipe; every base image and package it carries is
# credited, with its upstream licence, in docs/credits/stack.v1.json.
LABEL org.opencontainers.image.licenses="GPL-3.0-or-later"

# DISTRO: apk (Alpine), NOT microdnf/dnf (Fedora)
RUN apk add --no-cache busybox-extras

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /var/www

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
