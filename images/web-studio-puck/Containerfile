# @trace order:1864-ay3x
# The Puck studio lane. TWO STAGES, by operator ruling 2026-11-02:
#   builder  esbuild bundles Puck + React 19 + the editor entry into ONE
#            browser file; this stage, with esbuild and node_modules, is
#            DISCARDED.
#   final    the bundle, its CSS, the editor page and the studio server. No
#            esbuild, no node_modules: React 19 exists only inside the bundle.
#            scripts/test-web-studio-puck.sh checks this.
#
# Licences approved by the operator 2026-11-02 (relayed by macuahuitl-fedora):
# @measured/puck 0.20.2 MIT and its tree with React 19 (MIT 19, BSD-3-Clause 1,
# 0BSD 1), shipped inside the bundle; esbuild 0.28.2 MIT and its platform
# binary @esbuild/linux-x64 MIT (linux-arm64 on an aarch64 builder, also MIT),
# BUILD-TIME ONLY. For the stack ledger (scripts/lua/build-stack-ledger.lua,
# #833) the source is build/package-lock.json: Puck and React as the bundle,
# esbuild as build-stage only. The ledger does not read it yet (follow-up).
FROM docker.io/library/node:22.19.0-bookworm-slim@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90 AS builder
WORKDIR /build
COPY build/package.json build/package-lock.json /build/
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY build/editor.jsx build/editor.html /build/
RUN mkdir -p /build/public \
    && node_modules/.bin/esbuild editor.jsx --bundle --minify --format=iife \
        --jsx=automatic --define:process.env.NODE_ENV='"production"' \
        --outfile=public/editor.js \
    && cp node_modules/@measured/puck/dist/index.css public/editor.css \
    && cp editor.html public/editor.html \
    && test -s public/editor.js && test -s public/editor.css

FROM docker.io/library/node:22.19.0-bookworm-slim@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90
LABEL io.tillandsias.web-studio.engine="puck" \
      io.tillandsias.web-studio.puck-version="0.20.2" \
      io.tillandsias.web-studio.react-version="19.2.0 (bundled)" \
      io.tillandsias.web-studio.licence="MIT" \
      io.tillandsias.web-studio.dependency-licences="MIT,BSD-3-Clause,0BSD" \
      io.tillandsias.web-studio.build-only="esbuild@0.28.2 MIT"
WORKDIR /opt/studio
COPY --from=builder /build/public /opt/studio/public
COPY server.mjs /opt/studio/
RUN useradd -u 1001 -m -s /usr/sbin/nologin studio \
    && mkdir -p /project && chown studio:studio /project
USER studio
EXPOSE 8090
ENV STUDIO_PROJECT=/project STUDIO_PORT=8090
ENTRYPOINT ["node", "/opt/studio/server.mjs"]
