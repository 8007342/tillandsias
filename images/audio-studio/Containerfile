# @trace order:2055-grzz
# The AUDIO STUDIO: a sibling appliance beside the forge (the ComfyUI studio's
# shape, order 1921-2krx), for analysis and transforms on audio. Generic: any
# project; kumbia is the first client. Never built unless a forge agent calls an
# audio.* tool (or the fixture builds it).
#
# Operator-approved contents (macuahuitl-fedora relay, 2026-11-08):
# - ffmpeg with libopus and the NATIVE AAC encoder. Debian's ffmpeg has no
#   libfdk-aac (non-free, never redistributable); the build step below fails
#   the image if that ever changes.
# - rubberband and sox: GPL tools, INSIDE THIS CONTAINER ONLY. They are never
#   shipped in a release artefact: like imagegen-studio, this image is built
#   on the host from this recipe, and no tray bundle carries these binaries
#   (scripts/lua/check-audio-studio-bundle.lua lists the bundle to prove it).
# - Python with numpy, scipy, librosa, soundfile and pyloudnorm, for the glitch
#   detector and for the agent's own analysis. The Python lives in this image
#   for users; the repo's scripts and tests never run it on the host
#   (scripts/lua/test-audio-studio-glitches.lua runs it in here).
# - torch (BSD-3-Clause, CPU build) and demucs 4.1.0 (MIT code; its WEIGHTS
#   are separate and gated, 2068-ypgq) for stem separation (2068-cqis).
# - tqdm 4.70.1, "MPL-2.0 AND MIT", which demucs.apply imports unconditionally.
#   Operator ruling 2026-11-10 (macuahuitl-fedora relay): allowed UNMODIFIED,
#   as in the ComfyUI image. MPL-2.0 is file-level copyleft: patching any tqdm
#   file would oblige us to publish that file's source, so this image never
#   patches it; requirements.lock pins the PyPI release as published.
#
# Run time: --network=none, --cap-drop=ALL, no-new-privileges, uid 1001, one
# container per call (audio_studio.rs). No model weights, ever: stem
# separation (2068-cqis: torch CPU + Demucs, below) reads the maintainer's
# safetensors, fetched on the user's machine after the project's licence
# acknowledgement (2068-ypgq) and bind-mounted READ-ONLY under /models for
# that one call. audio-tool refuses any other file (a .th pickle, a wrong
# sha256) and disables torch.load before Demucs is imported. Generative tools
# (2055-dihg) bring theirs the same way.
FROM docker.io/library/python:3.12.16-slim-bookworm
# 1958-yfib: our own label, never the base's. The recipe is Tillandsias's
# (GPL-3.0-or-later); the compound label names the GPL-2.0-or-later tools it is
# mostly made of (sox, rubberband, Debian's GPL build of ffmpeg; operator ruling
# 2026-11-01 on compound labels). Every package it carries is credited with its upstream
# licence in docs/credits/stack.v1.json.
LABEL org.opencontainers.image.licenses="GPL-3.0-or-later AND GPL-2.0-or-later"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg sox rubberband-cli libsndfile1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && ffmpeg -hide_banner -encoders 2>/dev/null | grep -q ' libopus ' \
    && ffmpeg -hide_banner -encoders 2>/dev/null | grep -qE '^ A[A-Z.]+ aac ' \
    && ! ffmpeg -hide_banner -buildconf 2>/dev/null | grep -q fdk \
    && sox --version && rubberband --version

# Every Python package at an exact version, the transitive set included.
# torch comes FIRST and ALONE from the pytorch CPU index (2068-cqis; the same
# version CorridorKey pins, as its CPU build): --index-url, not
# --extra-index-url, so nothing else can resolve there, and --no-deps, so its
# dependencies come from the lock below. CPU only: a GPU separation run is a
# later criterion of 2068-cqis, not this image.
ARG TORCH_VERSION=2.9.1+cpu
LABEL io.tillandsias.audio-studio.torch="${TORCH_VERSION}"
RUN pip install --no-cache-dir --no-deps "torch==${TORCH_VERSION}" \
        --index-url https://download.pytorch.org/whl/cpu
COPY requirements.lock /opt/tillandsias/requirements.lock
# pip check must find NOTHING broken except demucs's four deliberately absent
# dependencies (requirements.lock says why); any other line fails the build.
RUN pip install --no-cache-dir --no-deps -r /opt/tillandsias/requirements.lock \
    && { pip check || true; } > /tmp/pip-check.txt \
    && if grep -vxE 'demucs 4\.1\.0 requires (huggingface-hub|lameenc|pyyaml|sphn), which is not installed\.' /tmp/pip-check.txt; then exit 1; fi \
    && rm /tmp/pip-check.txt \
    && python -c "import numpy, scipy, librosa, soundfile, pyloudnorm, torch, safetensors, demucs.htdemucs, demucs.apply; assert not torch.cuda.is_available(); print('audio stack ok, torch', torch.__version__)"

COPY audio-tool.py /opt/tillandsias/audio-tool.py
RUN useradd -u 1001 -m -s /usr/sbin/nologin studio \
    && mkdir -p /work/tmp/audio /home/studio/.cache \
    && chown -R studio:studio /work/tmp/audio /home/studio \
    && python /opt/tillandsias/audio-tool.py versions

USER studio
# numba (librosa's JIT) caches next to the code by default; the code is
# read-only, so it caches under the studio's home.
ENV NUMBA_CACHE_DIR=/home/studio/.cache/numba \
    HOME=/home/studio
WORKDIR /work/tmp/audio
ENTRYPOINT ["python", "/opt/tillandsias/audio-tool.py"]
