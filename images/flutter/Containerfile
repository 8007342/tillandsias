# @trace spec:local-web-preview, order:1637-5765
# Opt-in Flutter toolchain for forge projects. A SIBLING image, like
# images/web-wrangler: it is never in INIT_IMAGES and is built only when a
# forge first runs `flutter`, so a user who never asks for Flutter never pulls
# 2.6 GB. The forge's `flutter` shim runs commands here against the forge's
# own project volume.
#
# Measured 2026-10-14 (plan/evidence/1637-5765-flutter-host-measurement-
# 2026-10-14/): the SDK comes from storage.googleapis.com at IMAGE BUILD time,
# so at forge time only pub.dev is needed (create, pub add), and
# `flutter build web` makes no connection at all.
FROM docker.io/library/debian:bookworm-slim@sha256:a4672c0cb26fbdde88e38fa2dfb6c681942306680e41e4378b28770b6e79ee91

# Flutter 3.47.7 stable, Dart 3.13.5. The release hash and the x64 archive's
# sha256 are copied from releases_linux.json; a bump changes all three.
ARG FLUTTER_VERSION=3.47.7
ARG FLUTTER_RELEASE_HASH=abaf9c523780a608bd46686fd5e53740a07077f8
ARG FLUTTER_X64_SHA256=af7455f540df951184c7953fbe3cf884766e7541dacf8571f9f582db03dd6230
ARG TARGETARCH

LABEL io.tillandsias.toolchain="flutter"
LABEL io.tillandsias.flutter.version="${FLUTTER_VERSION}"

# One install layer: git (the SDK is a git checkout and the tool reads its
# version from it), curl, xz and unzip (the SDK and pub archives), CA roots.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git unzip xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 1000 -m -s /bin/bash forge \
    && mkdir -p /opt/flutter && chown forge:forge /opt/flutter

USER forge
# BOT=false: flutter_tools' bot detector otherwise probes the cloud metadata
# address 169.254.169.254 on first run (measured). The proxy refuses it anyway;
# this keeps the tool from trying.
ENV FLUTTER_ROOT=/opt/flutter \
    PATH=/opt/flutter/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    BOT=false \
    FLUTTER_SUPPRESS_ANALYTICS=true \
    PUB_CACHE=/home/forge/.pub-cache

# x64: the published archive, verified by sha256. arm64: Flutter publishes no
# Linux arm64 archive, so the pinned tag is cloned and its commit must equal
# the release hash; precache then fetches the arm64 Dart and web SDKs.
RUN set -eu; \
    case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
      amd64) \
        curl -fsSL "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" -o /tmp/flutter.tar.xz; \
        echo "${FLUTTER_X64_SHA256}  /tmp/flutter.tar.xz" | sha256sum -c -; \
        tar -xJf /tmp/flutter.tar.xz -C /opt; \
        rm /tmp/flutter.tar.xz ;; \
      arm64) \
        git clone --depth 1 --branch "${FLUTTER_VERSION}" https://github.com/flutter/flutter.git /opt/flutter; \
        test "$(git -C /opt/flutter rev-parse HEAD)" = "${FLUTTER_RELEASE_HASH}" ;; \
      *) echo "unsupported architecture" >&2; exit 1 ;; \
    esac; \
    git config --global --add safe.directory /opt/flutter; \
    flutter config --no-analytics --no-cli-animations; \
    dart --disable-analytics; \
    flutter precache --web --no-android --no-ios --no-linux --no-windows --no-macos --no-fuchsia --no-universal; \
    flutter --version

WORKDIR /home/forge
CMD ["flutter", "--version"]
