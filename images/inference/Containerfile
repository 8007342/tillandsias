# @trace spec:inference-container
# Local LLM inference server for Tillandsias enclave network.
# Runs ollama — models stay cached via volume mount.
# Built on Fedora Minimal to match the forge image.
# DISTRO: Fedora Minimal 44 — microdnf (NOT dnf), glibc, bash default.
#         Health checks use curl (installed explicitly, NOT wget).
#         User creation: useradd (NOT Alpine's adduser -D).
#         CA bundle at /etc/pki/tls/certs/ca-bundle.crt (NOT Alpine's /etc/ssl/).
FROM registry.fedoraproject.org/fedora-minimal:44

# @trace spec:inference-container
# Runtime deps for ollama, minimal deps for running ollama CPU-only
# pciutils provides lspci (runtime GPU detection in entrypoint)
# DISTRO: microdnf (Fedora Minimal), NOT apk (Alpine) or dnf (standard Fedora)
# DISTRO: wget intentionally omitted — curl is the HTTP tool here.
#         Rust health checks (handlers.rs) MUST use curl, not wget.
RUN microdnf install -y bash curl ca-certificates zstd tar gzip pciutils \
    && microdnf clean all

# -- Create non-root user --
# DISTRO: useradd (Fedora shadow-utils), NOT adduser -D (Alpine)
RUN useradd -u 1000 -m -s /bin/bash ollama

# -- Model cache directory (volume-mountable) --
RUN mkdir -p /home/ollama/.ollama/models/ \
    && chown -R 1000:1000 /home/ollama

# -- CA bundle drop dir (writable by ollama uid so entrypoint can inject the enclave CA) --
# The entrypoint runs as USER 1000:1000 and copies /etc/tillandsias/ca.crt into
# /etc/pki/ca-trust/source/anchors/ for `update-ca-trust`. Pre-creating
# the directory here (while still root) avoids `mkdir: Permission denied`
# tripping `set -e` and exiting the container immediately on startup.
# DISTRO: Fedora uses /etc/pki/ca-trust/source/anchors + update-ca-trust,
#         NOT Debian's /usr/local/share/ca-certificates + update-ca-certificates.
RUN mkdir -p /etc/pki/ca-trust/source/anchors \
    && chown 1000:1000 /etc/pki/ca-trust/source/anchors

# ── Prepare model cache directory ─────
# @trace spec:inference-container, spec:zen-default-with-ollama-analysis-pool
# Model pulling is deferred to entrypoint at container startup (first run only).
# This keeps image build time fast (<30s) and avoids blocking build on 2.4GB downloads.
# The entrypoint pulls T0 + T1 (qwen2.5:0.5b, llama3.2:3b) on first container start,
# then caches them in ~/.cache/tillandsias/models/ (host-mounted volume).
# Subsequent container starts reuse the cached models immediately.
# See: project_squid_ollama_eof.md (Squid EOF workaround via deferred pulls).
RUN mkdir -p /opt/baked-models && chown -R 1000:1000 /opt/baked-models

# -- Entrypoint --
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
# @trace spec:inference-container — order 392a model preload policy
# POSIX sh helper sourced by the entrypoint BEFORE `ollama serve` (it exports
# OLLAMA_MAX_LOADED_MODELS, which ollama reads once at process start). Kept a
# separate file so litmus can exercise every policy branch with stubbed inputs
# without booting a container.
COPY preload-policy.sh /usr/local/bin/tillandsias-preload-policy.sh
# @trace spec:inference-container — order 406 accelerator engine tuning
# Same contract as preload-policy.sh: POSIX sh, sourced by the entrypoint BEFORE
# `ollama serve` (it exports OLLAMA_FLASH_ATTENTION / OLLAMA_KV_CACHE_TYPE /
# OLLAMA_NUM_PARALLEL, which ollama reads once at process start), and runnable
# standalone so litmus can exercise every tier branch with stubbed inputs.
COPY engine-tuning.sh /usr/local/bin/tillandsias-engine-tuning.sh
# @trace spec:external-logs-layer
# Manifest of curated external log files published by this image.
# The tray-side auditor reads this at /etc/tillandsias/external-logs.yaml
# every 60 s and flags unlisted files in the role dir as LEAK events.
RUN mkdir -p /etc/tillandsias
COPY external-logs.yaml /etc/tillandsias/external-logs.yaml
RUN chmod +x /usr/local/bin/entrypoint.sh \
    /usr/local/bin/tillandsias-preload-policy.sh \
    /usr/local/bin/tillandsias-engine-tuning.sh

USER 1000:1000

EXPOSE 11434

# @trace spec:inference-container, spec:socket-container-orchestration
# @trace spec:inference-container — order 406 truthful readiness
#
# ORDER 406: `/api/version` alone is NOT a health signal for this container. It
# answers the moment `ollama serve` binds the port, which happens even when the
# engine payload is missing llama-server — the binary ollama execs for every
# model load. The live repro on macuahuitl 2026-07-29 had this container sitting
# at `Up (healthy)` while EVERY /api/generate returned HTTP 500
# "llama-server binary not found". A health badge on a server that cannot serve
# is worse than no badge: the launcher's readiness gate believed it.
#
# So the probe asserts BOTH: the API is up AND the engine can actually load a
# model. llama-server lives in the host-mounted, forge-SHARED model cache, so
# this cannot be a start-time-only check — a concurrent prune of that volume
# must turn this container unhealthy rather than leave it serving 500s.
# A real generate would be the strongest assertion but is far too expensive at a
# 5s interval; the entrypoint does that capability check once at startup and
# refuses to come up without it.
HEALTHCHECK --interval=5s --timeout=10s --start-period=30s --retries=12 \
    CMD curl -sf http://127.0.0.1:11434/api/version >/dev/null \
        && test -x /home/ollama/.ollama/models/.tools/lib/ollama/llama-server \
        || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
ENV HOME=/home/ollama USER=ollama
